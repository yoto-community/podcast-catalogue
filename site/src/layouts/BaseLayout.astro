---
import "../styles/global.css";
import { getManifest } from "../lib/catalog";
import { formatDateLong } from "../lib/format";
import { serializeJsonLd } from "../lib/seo";
import { pageUrl } from "../lib/url";
import FavoritesInit from "../components/FavoritesInit.astro";

interface Props {
  title: string;
  description: string;
  /** Chemin de la page *sans* `base` (ex. `/fr/age-7-10/animalite/`). */
  path: string;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  image?: string;
  /** Langue de la page pour `html lang` et hreflang (ex. "fr", "en"). */
  lang?: string;
}

const { title, description, path, jsonLd, image, lang = "fr" } = Astro.props;
const manifest = getManifest();
const site = Astro.site;
const canonical = site ? new URL(pageUrl(path), site).href : undefined;
const ogImage = image
  ? /^https?:\/\//.test(image)
    ? image
    : site
      ? new URL(pageUrl(image), site).href
      : pageUrl(image)
  : pageUrl("/placeholder.svg");
const cleanPath = path.replace(/\/+$/, "") || "/";

/** `aria-current="page"` si `prefix` correspond à la page affichée. */
function isCurrent(prefix: string): "page" | undefined {
  if (prefix === "/") {
    return cleanPath === "/" || cleanPath === "/index" ? "page" : undefined;
  }
  return cleanPath === prefix || cleanPath.startsWith(`${prefix}/`) ? "page" : undefined;
}

const navItems = [
  { prefix: "/", label: "Catalogue", href: pageUrl("/") },
  { prefix: "/editeurs", label: "Éditeurs", href: pageUrl("/editeurs/") },
  { prefix: "/auteurs", label: "Auteurs", href: pageUrl("/auteurs/") },
  { prefix: "/favoris", label: "Favoris", href: pageUrl("/favoris/") },
];

/** Liens regroupés dans le menu « Communauté ». */
const communityItems = [
  { prefix: "/developers", label: "API", href: pageUrl("/developers/") },
  { prefix: "/health", label: "Santé flux", href: pageUrl("/health/") },
  { prefix: "/contribuer", label: "Contribuer", href: pageUrl("/contribuer/") },
];
const communityCurrent = communityItems.some((item) => isCurrent(item.prefix) === "page");
const repoUrl = "https://github.com/yoto-community/podcast-catalogue";
const updated = formatDateLong(manifest.updatedAt);

/** Génère les liens `hreflang` pour les langues disponibles. */
function getHreflangLinks(): Array<{ hreflang: string; href: string }> {
  if (!site) return [];
  const links = [{ hreflang: "x-default", href: new URL(pageUrl("/"), site).href }];
  const manifest = getManifest();
  for (const language of manifest.languages) {
    const langPath = pageUrl(`/${language.code}/`);
    links.push({ hreflang: language.code, href: new URL(langPath, site).href });
  }
  return links;
}

const hreflangLinks = getHreflangLinks();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={pageUrl("/favicon.svg")} type="image/svg+xml" />
    <link rel="manifest" href={pageUrl("/manifest.webmanifest")} />
    <link rel="apple-touch-icon" href={pageUrl("/icons/apple-icon-180.png")} sizes="180x180" />
    <meta name="theme-color" content="#f6f6f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101012" media="(prefers-color-scheme: dark)" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Podcasts Enfants" />
    {canonical && <link rel="canonical" href={canonical} />}
    {hreflangLinks.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}
    <meta property="og:site_name" content="Annuaire de podcasts pour enfants" />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "fr_FR"} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#contenu">
      Aller au contenu principal
    </a>

    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-logo" href={pageUrl("/")}>
          <span class="site-logo__mark" aria-hidden="true">
            ◉
          </span>
          <span>Annuaire de podcasts</span>
        </a>
        <nav class="site-nav" aria-label="Navigation principale">
          <ul>
            {navItems.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.prefix)}>
                  {item.label}
                </a>
              </li>
            ))}
            <li>
              <details
                class:list={["site-nav__group", { "is-active": communityCurrent }]}
                data-nav-group
              >
                <summary class="site-nav__summary">
                  Communauté
                  <svg
                    class="site-nav__caret"
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path
                      d="M6 9l6 6 6-6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    ></path>
                  </svg>
                </summary>
                <ul class="site-nav__panel" data-nav-panel>
                  {communityItems.map((item) => (
                    <li>
                      <a href={item.href} aria-current={isCurrent(item.prefix)}>
                        {item.label}
                      </a>
                    </li>
                  ))}
                  <li class="site-nav__panel-external">
                    <a href={repoUrl} target="_blank" rel="noopener noreferrer">
                      GitHub
                      <span class="site-nav__external-mark" aria-hidden="true">
                        ↗
                      </span>
                      <span class="sr-only">(nouvel onglet)</span>
                    </a>
                  </li>
                </ul>
              </details>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="contenu" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <p class="site-footer__freshness" data-catalog-freshness>
          {updated && (
            <>
              Catalogue mis à jour le <time datetime={manifest.updatedAt}>{updated}</time>
            </>
          )}
          {" — "}
          <span class="site-footer__version">
            version <code title="catalogVersion">{manifest.catalogVersion}</code>
          </span>
        </p>
        <p class="site-footer__meta">
          {manifest.counts.total} podcasts · données publiques, libres de réutilisation.
        </p>
      </div>
    </footer>

    <!-- PWA Update Toast -->
    <div class="pwa-toast" id="pwa-toast" hidden role="status" aria-live="polite" aria-atomic="true">
      <div class="pwa-toast__inner">
        <p class="pwa-toast__message">
          Une nouvelle version de l'application est disponible.
        </p>
        <div class="pwa-toast__actions">
          <button type="button" class="btn btn--primary pwa-toast__refresh" data-pwa-refresh>
            Rafraîchir maintenant
          </button>
          <button type="button" class="btn btn--ghost pwa-toast__dismiss" data-pwa-dismiss aria-label="Ignorer">
            Plus tard
          </button>
        </div>
      </div>
    </div>

    <div class="player" id="lecteur" data-player hidden>
      <div class="player__inner">
        <div class="player__text">
          <p class="player__title" data-player-title></p>
          <p class="player__artist" data-player-artist></p>
        </div>

        <div class="player__controls">
          <button
            type="button"
            class="player__toggle"
            data-player-toggle
            aria-label="Lecture"
            aria-pressed="false"
          >
            <svg
              class="player__icon"
              data-icon-play
              viewBox="0 0 24 24"
              width="22"
              height="22"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M8 5.5v13l11-6.5z" fill="currentColor"></path>
            </svg>
            <svg
              class="player__icon"
              data-icon-pause
              viewBox="0 0 24 24"
              width="22"
              height="22"
              aria-hidden="true"
              focusable="false"
              style="display: none"
            >
              <path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor"></path>
            </svg>
            <span class="sr-only">Lecture ou pause</span>
          </button>

          <label class="sr-only" for="player-seek">
            Position dans l’épisode
          </label>
          <input
            class="player__seek"
            id="player-seek"
            data-player-seek
            type="range"
            min="0"
            max="100"
            step="0.1"
            value="0"
          />

          <p class="player__time">
            <span class="sr-only">Temps de lecture : </span>
            <span data-player-current>0:00</span>
            <span aria-hidden="true"> / </span>
            <span data-player-duration>0:00</span>
          </p>
        </div>

        <div class="player__actions">
          <a class="player__link" data-player-external rel="noopener noreferrer">
            Écouter sur le site de l’éditeur
          </a>
          <a class="player__link" data-player-download download>
            Télécharger
          </a>
          <button
            type="button"
            class="player__close"
            data-player-close
            aria-label="Fermer le lecteur"
          >
            <svg
              viewBox="0 0 24 24"
              width="18"
              height="18"
              aria-hidden="true"
              focusable="false"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
            <span class="sr-only">Fermer le lecteur</span>
          </button>
        </div>
      </div>

      <div class="player__error" data-player-error hidden role="alert">
        <p>
          <strong>Écoute indisponible ici.</strong>
          Utilisez le lien vers le site de l’éditeur ou téléchargez l’épisode.
        </p>
        <button type="button" class="player__retry" data-player-retry>
          Réessayer
        </button>
      </div>

      <audio data-player-audio preload="metadata"></audio>
    </div>

    <script>
      import "../scripts/site.ts";
      // PWA Update toast handling
      if ("serviceWorker" in navigator) {
        import("virtual:pwa-register").then(({ registerSW }) => {
          registerSW({
            onNeedRefresh() {
              const toast = document.getElementById("pwa-toast");
              if (toast) {
                toast.hidden = false;
                document.body.classList.add("pwa-toast-visible");
              }
            },
            onOfflineReady() {
              console.log("App ready to work offline");
            },
          });
        });
      }
      // Toast button handlers
      document.addEventListener("click", (e: MouseEvent) => {
        const refreshBtn = e.target instanceof Element ? e.target.closest("[data-pwa-refresh]") : null;
        const dismissBtn = e.target instanceof Element ? e.target.closest("[data-pwa-dismiss]") : null;
        if (refreshBtn) {
          navigator.serviceWorker.getRegistrations().then((registrations) => {
            for (const reg of registrations) {
              if (reg.waiting) {
                reg.waiting.postMessage({ type: "SKIP_WAITING" });
              }
            }
          });
          window.location.reload();
        }
        if (dismissBtn) {
          const toast = document.getElementById("pwa-toast");
          if (toast) {
            toast.hidden = true;
            document.body.classList.remove("pwa-toast-visible");
          }
        }
      });
    </script>
    <FavoritesInit />
  </body>
</html>
