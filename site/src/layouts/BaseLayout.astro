---
import "@fontsource-variable/nunito";
import "../styles/global.css";
import { getManifest } from "../lib/catalog";
import { formatDateLong } from "../lib/format";
import { t, type Locale } from "../lib/i18n";
import {
  authorsPath,
  favoritesPath,
  homePath,
  publishersPath,
  searchPath,
  themesPath,
  newReleasesPath,
} from "../lib/routes";
import { serializeJsonLd } from "../lib/seo";
import { pageUrl } from "../lib/url";
import FavoritesInit from "../components/FavoritesInit.astro";
import LanguageSwitch from "../components/LanguageSwitch.astro";
import ThemeSwitch from "../components/ThemeSwitch.astro";

interface Props {
  title: string;
  description: string;
  /** Chemin de la page *sans* `base` (ex. `/fr/age-7-10/animalite/`). */
  path: string;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  image?: string;
  /** Langue de l'interface de la page. */
  locale: Locale;
  /** Chemins équivalents FR/EN, pour hreflang et le sélecteur de langue. */
  alternates?: Partial<Record<Locale, string>>;
}

const { title, description, path, jsonLd, image, locale, alternates } = Astro.props;
const manifest = getManifest();
const site = Astro.site;
const canonical = site ? new URL(pageUrl(path), site).href : undefined;
const ogImage = image
  ? /^https?:\/\//.test(image)
    ? image
    : site
      ? new URL(pageUrl(image), site).href
      : pageUrl(image)
  : pageUrl("/placeholder.svg");
const cleanPath = path.replace(/\/+$/, "") || "/";

/** `aria-current="page"` si le chemin correspond à la section. */
function isCurrent(prefix: string, exact = false): "page" | undefined {
  const clean = prefix.replace(/\/+$/, "") || "/";
  if (exact) return cleanPath === clean ? "page" : undefined;
  return cleanPath === clean || cleanPath.startsWith(`${clean}/`) ? "page" : undefined;
}

const navItems = [
  {
    prefix: homePath(locale),
    label: t(locale, "navCatalogue"),
    href: pageUrl(homePath(locale)),
    exact: true,
  },
  {
    prefix: publishersPath(locale),
    label: t(locale, "navPublishers"),
    href: pageUrl(publishersPath(locale)),
    exact: false,
  },
  {
    prefix: authorsPath(locale),
    label: t(locale, "navAuthors"),
    href: pageUrl(authorsPath(locale)),
    exact: false,
  },
  {
    prefix: favoritesPath(locale),
    label: t(locale, "navFavorites"),
    href: pageUrl(favoritesPath(locale)),
    exact: false,
  },
];

/** Pages hors périmètre, en français uniquement : visibles seulement dans la nav FR. */
const communityItems =
  locale === "fr"
    ? [
        { prefix: "/developers", label: t(locale, "navApi"), href: pageUrl("/developers/") },
        { prefix: "/health", label: t(locale, "navHealth"), href: pageUrl("/health/") },
        { prefix: "/contribuer", label: t(locale, "navContribute"), href: pageUrl("/contribuer/") },
      ]
    : [];

/** Liens vers les autres sites de la communauté Yoto. */
const ecosystemItems = [
  { label: t(locale, "navAwesomeYoto"), href: "https://yoto-community.github.io/" },
  {
    label: t(locale, "navIconsCatalogue"),
    href: "https://yoto-community.github.io/icons-catalogue/",
  },
];

const communityCurrent = communityItems.some((item) => isCurrent(item.prefix) === "page");
const repoUrl = "https://github.com/yoto-community/podcast-catalogue";
const updated = formatDateLong(manifest.updatedAt, locale);

/** Liens `hreflang` : uniquement quand la page existe dans les deux interfaces. */
const hreflangLinks =
  site && alternates
    ? [
        {
          hreflang: "x-default",
          href: new URL(pageUrl(alternates.fr ?? alternates.en ?? homePath("fr")), site).href,
        },
        ...(["fr", "en"] as const)
          .filter((code) => alternates[code])
          .map((code) => ({
            hreflang: code,
            href: new URL(pageUrl(alternates[code]!), site).href,
          })),
      ]
    : [];

// Les pages hors périmètre (Contribuer, API, Santé) restent en français.
const sectionPrefixes = [
  searchPath(locale),
  themesPath(locale),
  authorsPath(locale),
  publishersPath(locale),
  newReleasesPath(locale),
  favoritesPath(locale),
].map((value) => value.replace(/\/+$/, ""));
const catalogueActive =
  cleanPath === homePath(locale).replace(/\/+$/, "") ||
  (cleanPath.startsWith(`${homePath(locale).replace(/\/+$/, "")}/`) &&
    !sectionPrefixes.some((prefix) => cleanPath.startsWith(prefix)));
---

<!doctype html>
<html lang={locale} data-locale={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          var theme = null;
          var raw = localStorage.getItem("yoto-community:prefs:v1");
          if (raw) {
            try {
              var prefs = JSON.parse(raw);
              if (
                prefs &&
                prefs.version === 1 &&
                (prefs.theme === "light" || prefs.theme === "dark" || prefs.theme === "system")
              ) {
                theme = prefs.theme;
              }
            } catch (error) {
              /* préférences corrompues */
            }
          }
          if (!theme) theme = localStorage.getItem("yoto-icons-theme");
          var dark =
            theme === "dark" ||
            ((!theme || theme === "system") &&
              window.matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.dataset.theme = dark ? "dark" : "light";
        } catch (error) {
          /* localStorage indisponible : le CSS système reste actif */
        }
      })();
    </script>
    <meta name="description" content={description} />
    <link rel="icon" href={pageUrl("/favicon.svg")} type="image/svg+xml" />
    <link rel="manifest" href={pageUrl("/manifest.webmanifest")} />
    <link rel="apple-touch-icon" href={pageUrl("/icons/apple-icon-180.png")} sizes="180x180" />
    <meta name="theme-color" content="#f7f3e9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101512" media="(prefers-color-scheme: dark)" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={t(locale, "metaSiteName")} />
    {canonical && <link rel="canonical" href={canonical} />}
    {hreflangLinks.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}
    <meta property="og:site_name" content={t(locale, "metaSiteName")} />
    <meta property="og:locale" content={locale === "en" ? "en_US" : "fr_FR"} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#contenu">
      {t(locale, "skipToContent")}
    </a>

    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-logo" href={pageUrl(homePath(locale))}>
          <span class="site-logo__mark" aria-hidden="true">
            <svg width="34" height="34" viewBox="0 0 34 34">
              <rect x="2" y="2" width="30" height="30" rx="10" fill="var(--accent)"></rect>
              <path
                d="M10 12v10M14 9v16M18 13v8M22 10v14M26 14v6"
                stroke="var(--bg)"
                stroke-width="2.2"
                stroke-linecap="round"
              ></path>
            </svg>
          </span>
          <span>{t(locale, "siteName")}</span>
        </a>
        <nav class="site-nav" aria-label={t(locale, "navMain")}>
          <ul>
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={
                    item.exact ? (catalogueActive ? "page" : undefined) : isCurrent(item.prefix)
                  }
                  data-nav-exact={item.exact ? "" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
            <li>
              <details
                class:list={["site-nav__group", { "is-active": communityCurrent }]}
                data-nav-group
              >
                <summary class="site-nav__summary">
                  {t(locale, "navCommunity")}
                  <svg
                    class="site-nav__caret"
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path
                      d="M6 9l6 6 6-6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    ></path>
                  </svg>
                </summary>
                <ul class="site-nav__panel" data-nav-panel>
                  {communityItems.map((item) => (
                    <li>
                      <a href={item.href} aria-current={isCurrent(item.prefix)}>
                        {item.label}
                      </a>
                    </li>
                  ))}
                  <li class="site-nav__panel-separator" aria-hidden="true"></li>
                  {ecosystemItems.map((item) => (
                    <li>
                      <a href={item.href} target="_blank" rel="noopener noreferrer">
                        {item.label}
                        <span class="site-nav__external-mark" aria-hidden="true">
                          ↗
                        </span>
                        <span class="sr-only">{t(locale, "newTab")}</span>
                      </a>
                    </li>
                  ))}
                  <li>
                    <a href={repoUrl} target="_blank" rel="noopener noreferrer">
                      {t(locale, "navGithub")}
                      <span class="site-nav__external-mark" aria-hidden="true">
                        {" "}
                        ↗{" "}
                      </span>
                      <span class="sr-only">{t(locale, "newTab")}</span>
                    </a>
                  </li>
                </ul>
              </details>
            </li>
          </ul>
        </nav>
        <ThemeSwitch locale={locale} />
        <LanguageSwitch locale={locale} alternates={alternates} />
      </div>
    </header>

    <main id="contenu" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <p class="site-footer__community">
          {t(locale, "footerCommunityBefore")}
          <a href="https://yoto-community.github.io/">{t(locale, "footerCommunityLink")}</a>
          {"— "}
          <a href="https://yoto-community.github.io/myo/">{t(locale, "footerMyoLink")}</a>.
        </p>
        <p class="site-footer__freshness" data-catalog-freshness>
          {updated && (
            <>
              {t(locale, "footerUpdatedBefore")}{" "}
              <time datetime={manifest.updatedAt}>{updated}</time>
            </>
          )}
          {"— "}
          <span class="site-footer__version">
            {t(locale, "footerVersion")}{" "}
            <code title="catalogVersion">{manifest.catalogVersion}</code>
          </span>
        </p>
        <p class="site-footer__meta">{t(locale, "footerMeta", { count: manifest.counts.total })}</p>
      </div>
    </footer>

    <!-- PWA Update Toast -->
    <div
      class="pwa-toast"
      id="pwa-toast"
      hidden
      role="status"
      aria-live="polite"
      aria-atomic="true"
    >
      <div class="pwa-toast__inner">
        <p class="pwa-toast__message">{t(locale, "pwaNewVersion")}</p>
        <div class="pwa-toast__actions">
          <button type="button" class="btn btn--primary pwa-toast__refresh" data-pwa-refresh>
            {t(locale, "pwaRefresh")}
          </button>
          <button
            type="button"
            class="btn btn--ghost pwa-toast__dismiss"
            data-pwa-dismiss
            aria-label={t(locale, "pwaDismiss")}
          >
            {t(locale, "pwaLater")}
          </button>
        </div>
      </div>
    </div>

    <div class="player" id="lecteur" data-player hidden>
      <div class="player__inner">
        <div class="player__text">
          <p class="player__title" data-player-title></p>
          <p class="player__artist" data-player-artist></p>
        </div>

        <div class="player__controls">
          <button
            type="button"
            class="player__toggle"
            data-player-toggle
            aria-label={t(locale, "playerPlay")}
            aria-pressed="false"
          >
            <svg
              class="player__icon"
              data-icon-play
              viewBox="0 0 24 24"
              width="22"
              height="22"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M8 5.5v13l11-6.5z" fill="currentColor"></path>
            </svg>
            <svg
              class="player__icon"
              data-icon-pause
              viewBox="0 0 24 24"
              width="22"
              height="22"
              aria-hidden="true"
              focusable="false"
              style="display: none"
            >
              <path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor"></path>
            </svg>
            <span class="sr-only">{t(locale, "playerToggleSr")}</span>
          </button>

          <label class="sr-only" for="player-seek">
            {t(locale, "playerPosition")}
          </label>
          <input
            class="player__seek"
            id="player-seek"
            data-player-seek
            type="range"
            min="0"
            max="100"
            step="0.1"
            value="0"
          />

          <p class="player__time">
            <span class="sr-only">{t(locale, "playerTime")}</span>
            <span data-player-current>0:00</span>
            <span aria-hidden="true"> / </span>
            <span data-player-duration>0:00</span>
          </p>
        </div>

        <div class="player__actions">
          <a class="player__link" data-player-external rel="noopener noreferrer">
            {t(locale, "playerListenExternal")}
          </a>
          <a class="player__link" data-player-download download>
            {t(locale, "playerDownload")}
          </a>
          <button
            type="button"
            class="player__close"
            data-player-close
            aria-label={t(locale, "playerClose")}
          >
            <svg
              viewBox="0 0 24 24"
              width="18"
              height="18"
              aria-hidden="true"
              focusable="false"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
            <span class="sr-only">{t(locale, "playerClose")}</span>
          </button>
        </div>
      </div>

      <div class="player__error" data-player-error hidden role="alert">
        <p>
          <strong>{t(locale, "playerErrorTitle")}</strong>
          {t(locale, "playerErrorText")}
        </p>
        <button type="button" class="player__retry" data-player-retry>
          {t(locale, "playerRetry")}
        </button>
      </div>

      <audio data-player-audio preload="metadata"></audio>
    </div>

    <script>
      import "../scripts/site.ts";
      // PWA Update toast handling
      if ("serviceWorker" in navigator) {
        import("virtual:pwa-register").then(({ registerSW }) => {
          registerSW({
            onNeedRefresh() {
              const toast = document.getElementById("pwa-toast");
              if (toast) {
                toast.hidden = false;
                document.body.classList.add("pwa-toast-visible");
              }
            },
            onOfflineReady() {
              console.log("App ready to work offline");
            },
          });
        });
      }
      // Toast button handlers
      document.addEventListener("click", (e: MouseEvent) => {
        const refreshBtn =
          e.target instanceof Element ? e.target.closest("[data-pwa-refresh]") : null;
        const dismissBtn =
          e.target instanceof Element ? e.target.closest("[data-pwa-dismiss]") : null;
        if (refreshBtn) {
          navigator.serviceWorker.getRegistrations().then((registrations) => {
            for (const reg of registrations) {
              if (reg.waiting) {
                reg.waiting.postMessage({ type: "SKIP_WAITING" });
              }
            }
          });
          window.location.reload();
        }
        if (dismissBtn) {
          const toast = document.getElementById("pwa-toast");
          if (toast) {
            toast.hidden = true;
            document.body.classList.remove("pwa-toast-visible");
          }
        }
      });
    </script>
    <FavoritesInit />
  </body>
</html>
