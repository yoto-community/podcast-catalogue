---
/**
 * Page de redirection (build statique — GitHub Pages n'a pas de 301).
 *
 * Une ancienne URL de tranche (`/fr/tout-petits/`, `/en/maternelle-cp/…`) est
 * regénérée à chaque build avec `meta refresh` + `canonical` vers la nouvelle
 * adresse, pour que les liens partagés et les moteurs de recherche suivent.
 * `noindex` : seules les URL canoniques doivent être indexées.
 */
import { pageUrl } from "../lib/url";

interface Props {
  /** Chemin cible, ex. `/fr/age-2-5/` (préfixé par `BASE_PATH`). */
  to: string;
  /** Langue du document. */
  lang?: string;
}

const { to, lang = "fr" } = Astro.props;
const target = pageUrl(to);
const canonical = Astro.site ? new URL(target, Astro.site).href : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page déplacée</title>
    <meta name="robots" content="noindex" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta http-equiv="refresh" content={`0;url=${target}`} />
  </head>
  <body>
    <p>
      Cette page a déménagé : <a href={target}>continuer vers {target}</a>
    </p>
  </body>
</html>
