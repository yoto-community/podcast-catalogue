---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CatalogBrowser from "../../../components/CatalogBrowser.astro";
import {
  entriesOfPublisher,
  entryPath,
  getPublishers,
  authorOptions,
  categoryOptions,
  groupOptions,
  languageOptions,
} from "../../../lib/catalog";
import { plural } from "../../../lib/format";
import { itemListJsonLd } from "../../../lib/seo";
import { pageUrl } from "../../../lib/url";
import type { StaticPath } from "../../../lib/types";

export function getStaticPaths(): Array<StaticPath<PublisherProps>> {
  return getPublishers()
    .filter((p) => entriesOfPublisher(p.slug).length > 0)
    .map((publisher) => ({
      params: { slug: publisher.slug },
      props: { publisher },
    }));
}

interface PublisherProps {
  publisher: { name: string; slug: string; count: number };
}

interface Props extends PublisherProps {}

const { publisher } = Astro.props;
const entries = entriesOfPublisher(publisher.slug);
const path = `/editeurs/${publisher.slug}/`;

const jsonLd = itemListJsonLd(
  `Podcasts — ${publisher.name}`,
  entries.map((entry) => ({
    name: entry.name,
    path: entryPath(entry),
  })),
  Astro.site,
);

const title = `${publisher.name} — podcasts`;
const description = `${plural(entries.length, "podcast")} de l'éditeur « ${publisher.name} » — écoute directe, description et lien vers le site de l'éditeur.`;

// Auteurs liés à cet éditeur
const authors = authorOptions(entries);
---

<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd} lang="fr">
  <nav class="breadcrumb" aria-label="Fil d'ariane">
    <ol>
      <li>
        <a href={pageUrl("/")}>Catalogue</a>
      </li>
      <li>
        <a href={pageUrl("/editeurs/")}>Éditeurs</a>
      </li>
      <li>
        <span aria-current="page">{publisher.name}</span>
      </li>
    </ol>
  </nav>

  {authors.length > 0 && (
    <section class="publisher-authors" aria-labelledby="authors-heading">
      <h2 id="authors-heading">Auteurs de cet éditeur</h2>
      <ul class="publisher-authors__list">
        {authors.map((author) => (
          <li class="publisher-authors__item">
            <a href={pageUrl(`/auteurs/${author.value}/`)}>
              <span class="publisher-authors__name">{author.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <CatalogBrowser
    title={publisher.name}
    intro={`${plural(entries.length, "podcast")} publiés par « ${publisher.name} ».`}
    entries={entries}
    languages={languageOptions(entries)}
    groups={groupOptions(entries)}
    categories={categoryOptions(entries)}
    authors={authors}
    preset={{}}
    showAuthorFilter={true}
    nav={{
      label: "Tous les éditeurs",
      items: [
        {
          href: pageUrl("/editeurs/"),
          label: "Tous les éditeurs",
          count: getPublishers().length,
          active: false,
        },
      ],
    }}
  />
</BaseLayout>

<style>
  .publisher-authors {
    margin: var(--space-6) 0;
    padding: var(--space-4);
    background: var(--surface);
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .publisher-authors h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .publisher-authors__list {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .publisher-authors__item {
    flex: 0 0 auto;
  }
  .publisher-authors__item a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) 0;
    color: var(--text);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 500;
    transition: color 0.15s;
  }
  .publisher-authors__item a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
