---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CatalogBrowser from "../../../components/CatalogBrowser.astro";
import {
  categoryOptions,
  entriesOf,
  entriesOfLanguage,
  entryPath,
  getGroups,
  getLanguages,
  groupAgeRange,
  groupLabel,
  groupPath,
  groupSlug,
} from "../../../lib/catalog";
import { plural } from "../../../lib/format";
import { agesOfGroup, formatAges } from "../../../lib/ages";
import { itemListJsonLd } from "../../../lib/seo";
import { pageUrl } from "../../../lib/url";
import type { ManifestGroup, ManifestLanguage, StaticPath } from "../../../lib/types";

export function getStaticPaths(): Array<StaticPath<GroupProps>> {
  const paths: Array<StaticPath<GroupProps>> = [];
  for (const language of getLanguages()) {
    for (const group of getGroups()) {
      if (entriesOf(language.code, group.id).length > 0) {
        paths.push({
          params: { lang: language.code, tranche: groupSlug(group, language.code) },
          props: { language, group },
        });
      }
    }
  }
  return paths;
}

interface GroupProps {
  language: ManifestLanguage;
  group: ManifestGroup;
}

interface Props extends GroupProps {}

const { language, group } = Astro.props;
const entries = entriesOf(language.code, group.id);
const groups = getGroups();
const label = groupLabel(group, language.code);
const ageRange = groupAgeRange(group, language.code);
const path = groupPath(language.code, group);

/** Âges exacts couverts par la tranche, pour dire clairement de qui il s'agit. */
const ages = agesOfGroup(group, groups);
const agesPart = group.ageMax === null ? "" : `, soit les âges ${formatAges(ages)}`;

/**
 * Borne partagée avec une autre tranche (5 et 7 ans existent dans deux tranches) :
 * on le dit explicitement plutôt que de laisser le parent deviner.
 */
const shared = groups.flatMap((other) => {
  if (other.id === group.id) return [];
  const found: Array<{ age: number; other: ManifestGroup }> = [];
  if (group.ageMax !== null && group.ageMax === other.ageMin) {
    found.push({ age: group.ageMax, other });
  }
  if (other.ageMax !== null && other.ageMax === group.ageMin) {
    found.push({ age: group.ageMin, other });
  }
  return found;
});
const sharedSentence = shared
  .map(
    ({ age, other }) =>
      ` Un enfant de ${age} ans trouvera aussi des podcasts en « ${groupLabel(other, language.code)} ».`,
  )
  .join("");

const jsonLd = itemListJsonLd(
  `${label} — podcasts`,
  entries.map((entry) => ({ name: entry.name, path: entryPath(entry) })),
  Astro.site,
);

const title = `${label} (${ageRange}) — podcasts en ${language.code === "fr" ? "français" : "anglais"}`;
const description = `${plural(entries.length, "podcast")} pour la tranche ${label} (${ageRange}), avec écoute directe et lien vers le site de l’éditeur.`;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  jsonLd={jsonLd}
  lang={language.code}
>
  <CatalogBrowser
    title={label}
    intro={`${plural(entries.length, "podcast")} pour la tranche « ${label} » — ${ageRange}${agesPart}.${sharedSentence}`}
    entries={entries}
    languages={[]}
    groups={[]}
    categories={categoryOptions(entries, language.code)}
    preset={{ language: language.code, group: group.id }}
    nav={{
      label: "Toutes les tranches",
      items: [
        {
          href: pageUrl(`/${language.code}/`),
          label: "Toutes les tranches",
          count: entriesOfLanguage(language.code).length,
          active: false,
        },
        ...getGroups()
          .map((candidate) => ({
            href: pageUrl(groupPath(language.code, candidate)),
            label: `${groupLabel(candidate, language.code)} · ${groupAgeRange(candidate, language.code)}`,
            count: entriesOf(language.code, candidate.id).length,
            active: candidate.id === group.id,
          }))
          .filter((item) => item.count > 0),
      ],
    }}
  />
</BaseLayout>
