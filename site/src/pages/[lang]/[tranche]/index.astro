---
import GroupPage from "../../../components/pages/GroupPage.astro";
import { getEntries, getGroups, groupSlug } from "../../../lib/catalog";
import { LOCALES, type Locale } from "../../../lib/i18n";
import type { ManifestGroup } from "../../../lib/types";

export function getStaticPaths() {
  const entries = getEntries();
  const paths = [];
  for (const locale of LOCALES) {
    for (const group of getGroups()) {
      if (!entries.some((entry) => entry.groupId === group.id)) continue;
      paths.push({
        params: { lang: locale, tranche: groupSlug(group, locale) },
        props: { locale, group },
      });
    }
  }
  return paths;
}

interface Props {
  locale: Locale;
  group: ManifestGroup;
}

const { locale, group } = Astro.props;
---

<GroupPage locale={locale} group={group} />
