---
import PodcastPage from "../../../../components/pages/PodcastPage.astro";
import { getEntries, groupSlugOfId } from "../../../../lib/catalog";
import { LOCALES, type Locale } from "../../../../lib/i18n";
import type { DistEntry } from "../../../../lib/types";

export function getStaticPaths() {
  const paths = [];
  for (const locale of LOCALES) {
    for (const entry of getEntries()) {
      paths.push({
        params: {
          lang: locale,
          tranche: groupSlugOfId(entry.groupId, locale),
          slug: entry.slug,
        },
        props: { locale, entry },
      });
    }
  }
  return paths;
}

interface Props {
  locale: Locale;
  entry: DistEntry;
}

const { locale, entry } = Astro.props;
---

<PodcastPage locale={locale} entry={entry} />
