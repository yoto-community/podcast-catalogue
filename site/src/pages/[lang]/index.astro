---
import HomePage from "../../components/pages/HomePage.astro";
import { LOCALES, type Locale } from "../../lib/i18n";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { lang: locale },
    props: { locale },
  }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<HomePage locale={locale} />
