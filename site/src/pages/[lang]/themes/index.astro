---
import ThemesIndexPage from "../../../components/pages/ThemesIndexPage.astro";
import { LOCALES, type Locale } from "../../../lib/i18n";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { lang: locale },
    props: { locale },
  }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<ThemesIndexPage locale={locale} />
