---
import AuthorPage from "../../../../components/pages/AuthorPage.astro";
import { entriesOfAuthor, getAuthors } from "../../../../lib/catalog";

export function getStaticPaths() {
  return getAuthors()
    .filter((author) => entriesOfAuthor(author.slug).length > 0)
    .map((author) => ({
      params: { lang: "fr", slug: author.slug },
      props: { author },
    }));
}

interface Props {
  author: { name: string; slug: string; count: number };
}

const { author } = Astro.props;
---

<AuthorPage locale="fr" author={author} />
