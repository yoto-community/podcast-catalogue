---
/**
 * Anciennes URL → page de redirection statique.
 *
 * GitHub Pages ne sait pas répondre en 301 : chaque ancienne adresse est
 * regénérée à chaque build avec un `meta refresh` + `canonical` vers l'adresse
 * actuelle, pour que les liens partagés et les moteurs de recherche suivent.
 *
 * Deux familles :
 *  - les alias de tranche (`/fr/tout-petits/…`), pilotés par `groups.json` ;
 *  - les pages cœur historiques, non préfixées (`/search/`, `/themes/…`), qui
 *    pointent désormais vers leur équivalent français `/fr/…`.
 */
import RedirectLayout from "../layouts/RedirectLayout.astro";
import {
  entriesOf,
  entriesOfAuthor,
  entriesOfPublisher,
  entriesOfTag,
  getAuthors,
  getGroups,
  getLanguages,
  getPublishers,
  getTags,
  groupSlug,
} from "../lib/catalog";
import {
  authorPath,
  authorsPath,
  favoritesPath,
  groupPath,
  newReleasesPath,
  publisherPath,
  publishersPath,
  searchPath,
  themePath,
  themesPath,
} from "../lib/routes";
import { isLocale } from "../lib/i18n";
import type { StaticPath } from "../lib/types";

interface Props {
  /** Chemin cible, ex. `/fr/age-2-5/`. */
  to: string;
  /** Langue du document. */
  lang: string;
}

export function getStaticPaths(): Array<StaticPath<Props>> {
  const paths: Array<StaticPath<Props>> = [];

  function add(legacy: string, to: string, lang = "fr"): void {
    paths.push({ params: { legacy }, props: { to, lang } });
  }

  // Alias de tranche (renommage neutralisé : `tout-petits` → `age-2-5`)
  for (const language of getLanguages()) {
    if (!isLocale(language.code)) continue;
    const locale = language.code;
    for (const group of getGroups()) {
      const canonical = groupSlug(group, locale);
      const target = groupPath(locale, group);
      const stale = (group.aliases ?? []).filter((alias) => alias !== canonical);
      if (stale.length === 0) continue;
      for (const alias of stale) {
        add(`${locale}/${alias}`, target, locale);
        for (const entry of entriesOf(locale, group.id)) {
          add(`${locale}/${alias}/${entry.slug}`, `${target}${entry.slug}/`, locale);
        }
      }
    }
  }

  // Pages cœur historiques (interface française)
  add("search", searchPath("fr"));
  add("themes", themesPath("fr"));
  for (const tag of getTags()) {
    if (entriesOfTag(tag.id).length) add(`themes/${tag.id}`, themePath("fr", tag.id));
  }
  add("auteurs", authorsPath("fr"));
  for (const author of getAuthors()) {
    if (entriesOfAuthor(author.slug).length)
      add(`auteurs/${author.slug}`, authorPath("fr", author.slug));
  }
  add("editeurs", publishersPath("fr"));
  for (const publisher of getPublishers()) {
    if (entriesOfPublisher(publisher.slug).length) {
      add(`editeurs/${publisher.slug}`, publisherPath("fr", publisher.slug));
    }
  }
  add("favoris", favoritesPath("fr"));
  add("nouveautes", newReleasesPath("fr"));

  return paths;
}

const { to, lang } = Astro.props;
---

<RedirectLayout to={to} lang={lang} />
