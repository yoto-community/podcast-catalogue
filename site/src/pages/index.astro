---
/**
 * La racine redirige vers `/fr/` par défaut, ou vers `/en/` si le visiteur a
 * déjà choisi l'anglais (localStorage `yoto-locale`). Le choix est mémorisé par
 * le sélecteur de langue du layout.
 */
import { pageUrl } from "../lib/url";

const fr = pageUrl("/fr/");
const en = pageUrl("/en/");
const canonical = Astro.site ? new URL(fr, Astro.site).href : fr;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Annuaire de podcasts pour enfants</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <script is:inline define:vars={{ fr, en }}>
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem("yoto-locale");
        } catch (error) {
          saved = null;
        }
        var target = saved === "en" ? en : fr;
        window.location.replace(target + window.location.search + window.location.hash);
      })();
    </script>
    <noscript>
      <meta http-equiv="refresh" content={`0;url=${fr}`} />
    </noscript>
  </head>
  <body>
    <p>
      <a href={fr}>Français</a> · <a href={en}>English</a>
    </p>
  </body>
</html>
