---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  entryPath,
  getEntries,
  getEpisodes,
  getGroups,
  groupAgeRange,
  groupLabel,
} from "../lib/catalog";
import { formatDate, isoDay } from "../lib/format";
import { pageUrl } from "../lib/url";
import type { DistEntry, DistEpisodesFile } from "../lib/types";

// Relative time formatting (French)
function formatRelativeTime(dateStr: string | null): string {
  if (!dateStr) return "—";
  const date = new Date(dateStr);
  const now = Date.now();
  const diffMs = now - date.getTime();
  const diffMins = Math.floor(diffMs / 60000);
  const diffHours = Math.floor(diffMs / 3600000);
  const diffDays = Math.floor(diffMs / 86400000);
  const diffMonths = Math.floor(diffDays / 30);
  const diffYears = Math.floor(diffDays / 365);

  if (diffMins < 1) return "à l'instant";
  if (diffMins < 60) return `il y a ${diffMins} min`;
  if (diffHours < 24) return `il y a ${diffHours} h`;
  if (diffDays < 30) return `il y a ${diffDays} j`;
  if (diffMonths < 12) return `il y a ${diffMonths} mois`;
  return `il y a ${diffYears} an${diffYears > 1 ? "s" : ""}`;
}

// Build-time data fetching - no runtime dependencies
const entries = getEntries();

// Read feed-health issue data from checked-in cache (updated by feed-health.yml workflow)
let feedHealthCache: {
  timestamp?: string;
  bySlug?: Record<string, { status: string; lastChecked: string; error?: string }>;
  byEntryName?: Record<string, Array<{ rule: string; message: string }>>;
  summary?: { errors: number; warnings: number; total: number };
} = {};

try {
  const fs = await import("node:fs");
  const path = await import("node:path");
  const cacheFile = path.join(process.cwd(), "..", ".cache", "feed-health.json");
  if (fs.existsSync(cacheFile)) {
    feedHealthCache = JSON.parse(fs.readFileSync(cacheFile, "utf8"));
  }
} catch {
  // Cache not available at build time - will show unknown status
}

interface PodcastHealth {
  entry: DistEntry;
  episodes: DistEpisodesFile | null;
  feedStatus: "healthy" | "stale" | "unhealthy" | "unknown";
  lastFetch: string | null;
  lastEpisodeDate: string | null;
  episodeCount: number;
  error?: string;
  warnings?: Array<{ rule: string; message: string }>;
}

function getHealth(entry: DistEntry): PodcastHealth {
  const episodes = getEpisodes(entry.slug);
  const feedHealth = feedHealthCache.bySlug?.[entry.slug];
  const warnings = feedHealthCache.byEntryName?.[entry.name];

  let feedStatus: PodcastHealth["feedStatus"] = "unknown";
  let lastFetch = episodes?.fetchedAt ?? null;
  let error = feedHealth?.error;

  if (feedHealth) {
    if (feedHealth.status === "ok") feedStatus = "healthy";
    else if (feedHealth.status === "stale") feedStatus = "stale";
    else if (feedHealth.status === "error") feedStatus = "unhealthy";
  } else if (episodes?.fetchedAt) {
    const hoursSinceFetch =
      (Date.now() - new Date(episodes.fetchedAt).getTime()) / (1000 * 60 * 60);
    if (hoursSinceFetch < 24) feedStatus = "healthy";
    else if (hoursSinceFetch < 72) feedStatus = "stale";
    else feedStatus = "unhealthy";
  }

  // Get last episode date from episodes data
  const lastEpisodeDate = episodes?.episodes?.[0]?.pubDate ?? null;

  return {
    entry,
    episodes,
    feedStatus,
    lastFetch,
    lastEpisodeDate,
    episodeCount: episodes?.count ?? episodes?.episodes.length ?? 0,
    error,
    warnings,
  };
}

const allHealth = entries.map(getHealth).sort((a, b) => {
  // Sort by status priority: unhealthy > stale > healthy > unknown
  const statusOrder = { unhealthy: 0, stale: 1, healthy: 2, unknown: 3 };
  return statusOrder[a.feedStatus] - statusOrder[b.feedStatus];
});

const stats = {
  total: allHealth.length,
  healthy: allHealth.filter((h) => h.feedStatus === "healthy").length,
  stale: allHealth.filter((h) => h.feedStatus === "stale").length,
  unhealthy: allHealth.filter((h) => h.feedStatus === "unhealthy").length,
  unknown: allHealth.filter((h) => h.feedStatus === "unknown").length,
};

const cacheTimestamp = feedHealthCache.timestamp
  ? formatDate(feedHealthCache.timestamp)
  : "inconnu";

const description = `État de santé des ${stats.total} flux RSS du catalogue — mis à jour à chaque build.`;

/** « 198 podcasts affichés » — le total du catalogue, constant (le compteur lui est dynamique). */
const totalLabel = `${stats.total} podcast${stats.total > 1 ? "s" : ""} affiché${stats.total > 1 ? "s" : ""}`;
---

<BaseLayout title="Santé des flux RSS" description={description} path="/health/" lang="fr">
  <section class="health" aria-labelledby="health-title">
    <header class="health__header">
      <h1 id="health-title">Santé des flux RSS</h1>
      <p class="health__intro">
        Vérification automatique hebdomadaire + indexation toutes les 6h.
        <span>
          <strong>🟢 Sain</strong> {"<"} 24h · <strong>🟡 Obsolète</strong> 24-72h ·{" "}
          <strong>🔴 Défaillant</strong> > 72h ou erreur.
        </span>
      </p>
      <p class="health__cache-info">
        Dernière vérification complète : {cacheTimestamp} ·
        {feedHealthCache.summary && (
          <>
            {feedHealthCache.summary.errors} erreur(s) bloquante(s) ·{" "}
            {feedHealthCache.summary.warnings} avertissement(s)
          </>
        )}
      </p>
      <div class="health__stats" role="status" aria-live="polite">
        <span class="stat stat--healthy" title="Flux récupérés il y a moins de 24h">
          <span class="stat__count">{stats.healthy}</span>
          <span class="stat__label">Sains</span>
        </span>
        <span class="stat stat--stale" title="Flux récupérés il y a 24-72h">
          <span class="stat__count">{stats.stale}</span>
          <span class="stat__label">Obsolètes</span>
        </span>
        <span
          class="stat stat--unhealthy"
          title="Flux en erreur ou non récupérés depuis plus de 72h"
        >
          <span class="stat__count">{stats.unhealthy}</span>
          <span class="stat__label">Défaillants</span>
        </span>
        <span class="stat stat--unknown" title="Pas de données de santé disponibles">
          <span class="stat__count">{stats.unknown}</span>
          <span class="stat__label">Inconnus</span>
        </span>
      </div>
    </header>

    <div class="health__controls">
      <label for="health-filter-status" class="sr-only">
        Filtrer par statut
      </label>
      <select id="health-filter-status" aria-label="Filtrer par statut">
        <option value="">Tous les statuts</option>
        <option value="unhealthy">🔴 Défaillants</option>
        <option value="stale">🟡 Obsolètes</option>
        <option value="healthy">🟢 Sains</option>
        <option value="unknown">⚪ Inconnus</option>
      </select>

      <label for="health-filter-language" class="sr-only">
        Filtrer par langue
      </label>
      <select id="health-filter-language" aria-label="Filtrer par langue">
        <option value="">Toutes les langues</option>
        <option value="fr">Français</option>
        <option value="en">English</option>
      </select>

      <label for="health-filter-group" class="sr-only">
        Filtrer par tranche d'âge
      </label>
      <select id="health-filter-group" aria-label="Filtrer par tranche d'âge">
        <option value="">Toutes les tranches</option>
        {getGroups().map((group) => (
          <option value={group.id}>
            {groupLabel(group, "fr")} ({groupAgeRange(group, "fr")})
          </option>
        ))}
      </select>

      <input
        type="search"
        id="health-search"
        placeholder="Rechercher un podcast…"
        aria-label="Rechercher un podcast par nom, éditeur ou erreur"
      />

      <button
        type="button"
        id="health-filter-clear"
        class="btn btn--ghost btn--sm"
        aria-label="Réinitialiser tous les filtres"
      >
        Effacer les filtres
      </button>
    </div>

    <p class="health__result-count" role="status" aria-live="polite" data-health-count>
      <strong class="health__result-count-current" data-health-visible>
        {stats.total}
      </strong>{" "}
      <span class="health__result-count-total">/ {totalLabel}</span>
    </p>

    <div class="health__active-filters" aria-live="polite" hidden>
      <span class="health__active-filters-label">Filtres actifs :</span>
      <div class="health__filter-chips"></div>
      <button
        type="button"
        class="health__clear-all btn btn--ghost btn--sm"
        aria-label="Tout effacer"
      >
        Tout effacer
      </button>
    </div>

    <div class="health__table-wrapper" data-health-table>
      <table class="health__table">
        <thead>
          <tr>
            <th scope="col">Podcast</th>
            <th scope="col" data-sort="language" aria-sort="none">
              Langue <span class="sort-indicator" aria-hidden="true"></span>
            </th>
            <th scope="col" data-sort="group" aria-sort="none">
              Tranche <span class="sort-indicator" aria-hidden="true"></span>
            </th>
            <th scope="col" data-sort="status" aria-sort="none">
              Statut <span class="sort-indicator" aria-hidden="true"></span>
            </th>
            <th scope="col" data-sort="lastFetch" aria-sort="none">
              Dernière récupération <span class="sort-indicator" aria-hidden="true"></span>
            </th>
            <th scope="col" data-sort="lastEpisode" aria-sort="none">
              Dernier épisode <span class="sort-indicator" aria-hidden="true"></span>
            </th>
            <th scope="col" data-sort="episodeCount" aria-sort="none">
              Épisodes <span class="sort-indicator" aria-hidden="true"></span>
            </th>
            <th scope="col">Détails</th>
          </tr>
        </thead>
        <tbody>
          {allHealth.map((health) => {
            const {
              entry,
              feedStatus,
              lastFetch,
              lastEpisodeDate,
              episodeCount,
              error,
              warnings,
              episodes,
            } = health;
            const statusIcon =
              feedStatus === "healthy"
                ? "🟢"
                : feedStatus === "stale"
                  ? "🟡"
                  : feedStatus === "unhealthy"
                    ? "🔴"
                    : "⚪";
            const statusLabel =
              feedStatus === "healthy"
                ? "Sain"
                : feedStatus === "stale"
                  ? "Obsolète"
                  : feedStatus === "unhealthy"
                    ? "Défaillant"
                    : "Inconnu";
            const fetchDate = lastFetch ? formatDate(lastFetch) : "—";
            const fetchRelative = lastFetch ? formatRelativeTime(lastFetch) : "—";
            const fetchDay = lastFetch ? isoDay(lastFetch) : null;
            const lastEpDate = lastEpisodeDate ? formatDate(lastEpisodeDate) : "—";
            const lastEpRelative = lastEpisodeDate ? formatRelativeTime(lastEpisodeDate) : "—";
            const lastEpDay = lastEpisodeDate ? isoDay(lastEpisodeDate) : null;
            const hasWarnings = warnings && warnings.length > 0;

            return (
              <>
                <tr
                  data-status={feedStatus}
                  data-language={entry.language}
                  data-group={entry.groupId}
                  data-search={
                    entry.name.toLowerCase() +
                    " " +
                    entry.publisher.toLowerCase() +
                    " " +
                    (error?.toLowerCase() ?? "") +
                    " " +
                    (warnings?.map((w) => w.message.toLowerCase()).join(" ") ?? "")
                  }
                  class={hasWarnings ? "health__row--has-warnings" : ""}
                >
                  <td class="health__podcast-cell">
                    <a href={pageUrl(entryPath(entry))} class="health__podcast-link">
                      <img
                        src={entry.imageUrl || pageUrl("/placeholder.svg")}
                        alt=""
                        width="32"
                        height="32"
                        loading="lazy"
                        decoding="async"
                      />
                      <div class="health__podcast-info">
                        <span class="health__podcast-name">{entry.name}</span>
                        <span class="health__publisher">{entry.publisher}</span>
                      </div>
                    </a>
                  </td>
                  <td data-label="Langue" data-sort-value={entry.language}>
                    <span class="badge">{entry.language === "fr" ? "Français" : "English"}</span>
                  </td>
                  <td data-label="Tranche" data-sort-value={entry.groupId}>
                    <span class="badge">{entry.ageRange}</span>
                  </td>
                  <td class="health__status" data-label="Statut" data-sort-value={feedStatus}>
                    <span
                      class={`health__status-badge health__status-badge--${feedStatus}`}
                      aria-label={statusLabel}
                    >
                      {statusIcon} {statusLabel}
                    </span>
                  </td>
                  <td data-label="Dernière récupération" data-sort-value={lastFetch ?? ""}>
                    {fetchDate && (
                      <>
                        <time datetime={fetchDay ?? lastFetch}>{fetchDate}</time>
                        <span class="health__relative">({fetchRelative})</span>
                      </>
                    )}
                    {!fetchDate && <span class="health__never">Jamais</span>}
                  </td>
                  <td data-label="Dernier épisode" data-sort-value={lastEpisodeDate ?? ""}>
                    {lastEpDate && (
                      <>
                        <time datetime={lastEpDay ?? lastEpisodeDate}>{lastEpDate}</time>
                        <span class="health__relative">({lastEpRelative})</span>
                      </>
                    )}
                    {!lastEpDate && <span class="health__never">—</span>}
                  </td>
                  <td data-label="Épisodes" data-sort-value={episodeCount}>
                    <span class="health__episode-count">
                      {episodeCount} épisode{episodeCount > 1 ? "s" : ""}
                    </span>
                  </td>
                  <td class="health__actions" data-label="Actions">
                    {hasWarnings && (
                      <button
                        type="button"
                        class="btn btn--ghost btn--sm health__warnings-toggle"
                        aria-expanded="false"
                        aria-controls={`warnings-${entry.slug}`}
                        data-target={`warnings-${entry.slug}`}
                      >
                        {warnings.length} avertissement{warnings.length > 1 ? "s" : ""}
                      </button>
                    )}
                    {error && (
                      <details class="health__error">
                        <summary>Erreur</summary>
                        <pre>{error}</pre>
                      </details>
                    )}
                    {episodes && (
                      <a href={pageUrl(entryPath(entry))} class="btn btn--ghost btn--sm">
                        Voir épisodes
                      </a>
                    )}
                    <a
                      href={entry.rssUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn btn--ghost btn--sm"
                    >
                      Flux RSS
                    </a>
                  </td>
                </tr>
                {hasWarnings && (
                  <tr id={`warnings-${entry.slug}`} class="health__warnings-row" hidden>
                    <td colspan={8} class="health__warnings-cell">
                      <details open>
                        <summary>Avertissements détaillés</summary>
                        <ul class="health__warnings-list">
                          {warnings.map((w) => (
                            <li>
                              <span class="health__warning-rule">[{w.rule}]</span>
                              <span class="health__warning-message">{w.message}</span>
                            </li>
                          ))}
                        </ul>
                      </details>
                    </td>
                  </tr>
                )}
              </>
            );
          })}
        </tbody>
      </table>
    </div>

    <div class="health__no-results" data-health-no-results hidden>
      <p class="health__no-results-text">Aucun podcast ne correspond aux filtres actifs.</p>
      <button type="button" class="btn btn--ghost btn--sm" data-health-reset>
        Réinitialiser les filtres
      </button>
    </div>

    {allHealth.length === 0 && (
      <div class="health__empty-state">
        <svg
          class="health__empty-icon"
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <h3>Aucun podcast ne correspond</h3>
        <p>Essayez d'élargir vos filtres ou de réinitialiser la recherche.</p>
        <button
          type="button"
          class="btn"
          onclick="document.getElementById('health-filter-clear').click()"
        >
          Voir tous les podcasts
        </button>
      </div>
    )}
  </section>

  <style is:global>
    .health__header {
      margin-bottom: var(--space-6);
    }
    .health__intro {
      color: var(--color-text-muted);
      margin-bottom: var(--space-4);
    }
    .health__cache-info {
      font-size: var(--text-sm);
      color: var(--color-text-muted);
      margin-bottom: var(--space-4);
    }
    .health__stats {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
    }
    .stat {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      padding: var(--space-3) var(--space-4);
      border-radius: var(--radius);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      min-width: 80px;
    }
    .stat--healthy {
      border-color: var(--color-success);
    }
    .stat--stale {
      border-color: var(--color-warning);
    }
    .stat--unhealthy {
      border-color: var(--color-error);
    }
    .stat--unknown {
      border-color: var(--color-border);
    }
    .stat__count {
      font-size: var(--text-2xl);
      font-weight: 700;
      line-height: 1;
    }
    .stat--healthy .stat__count {
      color: var(--color-success);
    }
    .stat--stale .stat__count {
      color: var(--color-warning);
    }
    .stat--unhealthy .stat__count {
      color: var(--color-error);
    }
    .stat__label {
      font-size: var(--text-xs);
      color: var(--color-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* Status badges - solid, higher contrast */
    .health__status-badge {
      display: inline-flex;
      align-items: center;
      gap: var(--space-1);
      padding: var(--space-1) var(--space-3);
      border-radius: var(--radius-full);
      font-weight: 700;
      font-size: var(--text-xs);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      white-space: nowrap;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    }
    .health__status-badge--healthy {
      background: var(--color-success);
      color: var(--color-success-contrast);
    }
    .health__status-badge--stale {
      background: var(--color-warning);
      color: var(--color-warning-contrast);
    }
    .health__status-badge--unhealthy {
      background: var(--color-error);
      color: var(--color-error-contrast);
    }
    .health__status-badge--unknown {
      background: var(--color-border);
      color: var(--color-text-muted);
    }

    /* Active filter chips - better visual hierarchy */
    .health__active-filters {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-bottom: var(--space-5);
      padding: var(--space-3) var(--space-4);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
    }
    .health__active-filters-label {
      font-size: var(--text-xs);
      font-weight: 600;
      color: var(--color-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .health__filter-chips {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }
    .health__filter-chip {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-1) var(--space-3);
      background: var(--color-primary);
      color: var(--color-primary-contrast);
      border-radius: var(--radius-full);
      font-size: var(--text-sm);
      font-weight: 500;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
    }
    .health__filter-chip button {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 20px;
      height: 20px;
      border: none;
      background: rgba(0, 0, 0, 0.1);
      color: inherit;
      cursor: pointer;
      border-radius: 50%;
      padding: 0;
      line-height: 1;
      font-size: var(--text-lg);
      font-weight: 700;
      transition: background 0.15s ease;
    }
    .health__filter-chip button:hover {
      background: rgba(0, 0, 0, 0.2);
    }
    .health__clear-all {
      margin-left: auto;
      padding: var(--space-2) var(--space-3);
      font-size: var(--text-sm);
    }

    .health__controls {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      margin-bottom: var(--space-5);
      padding: var(--space-4);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
    }
    .health__controls select,
    .health__controls input {
      padding: var(--space-2) var(--space-3);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      background: var(--color-background);
      color: var(--color-text);
      font-size: var(--text-sm);
      min-width: 160px;
      transition:
        border-color 0.15s ease,
        box-shadow 0.15s ease;
    }
    .health__controls select:focus,
    .health__controls input:focus {
      border-color: var(--color-primary);
      box-shadow: 0 0 0 3px var(--color-primary-focus);
      outline: none;
    }
    .health__controls input {
      flex: 1;
      min-width: 240px;
    }

    /* Live result counter - feedback that filters are applied */
    .health__result-count {
      margin: calc(-1 * var(--space-3)) 0 var(--space-4);
      font-size: var(--text-sm);
      color: var(--color-text-muted);
    }
    .health__result-count-current {
      color: var(--color-text);
      font-variant-numeric: tabular-nums;
    }
    .health__result-count-total {
      font-variant-numeric: tabular-nums;
    }

    /* Empty state when active filters match nothing (build-time state covers an empty catalogue) */
    .health__no-results {
      text-align: center;
      padding: var(--space-8) var(--space-4);
      border: 1px dashed var(--color-border);
      border-radius: var(--radius);
      background: var(--color-surface);
      color: var(--color-text-muted);
    }
    .health__no-results-text {
      margin: 0 0 var(--space-4);
      font-size: var(--text-sm);
    }

    .health__table-wrapper {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      margin-top: var(--space-4);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      background: var(--color-background);
    }

    .health__table {
      width: 100%;
      border-collapse: collapse;
      font-size: var(--text-sm);
      min-width: 1300px;
    }
    .health__table th,
    .health__table td {
      padding: var(--space-3) var(--space-4);
      text-align: left;
      border-bottom: 1px solid var(--color-border);
      vertical-align: middle;
    }
    .health__table th {
      background: var(--color-surface);
      font-weight: 600;
      color: var(--color-text-muted);
      position: sticky;
      top: 0;
      z-index: 1;
      white-space: nowrap;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-size: var(--text-xs);
      border-bottom: 2px solid var(--color-border);
    }
    /* Zebra striping */
    .health__table tbody tr:nth-child(even) td {
      background: rgba(0, 0, 0, 0.015);
    }
    .health__table tbody tr:hover td {
      background: var(--color-surface-hover);
    }
    .health__table tbody tr.health__row--has-warnings {
      background: rgba(var(--color-warning-rgb), 0.06);
    }
    .health__table tbody tr.health__row--has-warnings:nth-child(even) {
      background: rgba(var(--color-warning-rgb), 0.08);
    }
    .health__podcast-link {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      text-decoration: none;
      color: var(--color-text);
    }
    .health__podcast-link:hover {
      text-decoration: underline;
    }
    .health__podcast-link img {
      border-radius: var(--radius-sm);
      object-fit: cover;
      flex-shrink: 0;
    }
    .health__podcast-info {
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 0;
    }
    .health__podcast-name {
      font-weight: 500;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .health__publisher {
      font-size: var(--text-xs);
      color: var(--color-text-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .health__status {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      white-space: nowrap;
    }
    .health__status-icon {
      font-size: var(--text-lg);
    }
    .health__never {
      color: var(--color-text-muted);
