---
import {
  categoryLabel,
  entryAgeRange,
  getGroups,
  groupLabel,
  languageLabelFor,
} from "../lib/catalog";
import { formatAges, agesOfGroup } from "../lib/ages";
import { t, type Locale } from "../lib/i18n";
import { searchIndex, normalizeText } from "../lib/text";
import { entryPath, authorPath, publisherPath } from "../lib/routes";
import { pageUrl, slugifyAuthor, slugifyPublisher } from "../lib/url";
import FavoriteButton from "./FavoriteButton.astro";
import type { DistEntry } from "../lib/types";

interface Props {
  entry: DistEntry;
  locale: Locale;
}

const { entry, locale } = Astro.props;

const href = pageUrl(entryPath(entry, locale));
const image = entry.imageUrl || pageUrl("/placeholder.svg");
const alt = entry.imageUrl ? t(locale, "coverAlt", { name: entry.name }) : "";
const groups = getGroups();
const group = groups.find((candidate) => candidate.id === entry.groupId);
/** Âges exacts couverts (bornes inclusives) — lus par le filtre « âge ». */
const ages = group ? agesOfGroup(group, groups) : [];
const agesText = formatAges(ages, locale);
const ageRange = entryAgeRange(entry, locale);
const searchText = searchIndex(
  entry.name,
  entry.publisher,
  entry.author,
  entry.description,
  categoryLabel(entry.category, locale),
);
const sortName = normalizeText(entry.name);
const sortCategory = `${normalizeText(categoryLabel(entry.category, locale))} ${sortName}`;
const authorSlug = entry.author !== "Inconnu" ? slugifyAuthor(entry.author) : "";
const publisherSlug = slugifyPublisher(entry.publisher);
---

<li
  class="card"
  data-entry
  data-language={entry.language}
  data-group={entry.groupId}
  data-ages={ages.join(",")}
  data-category={entry.category}
  data-author={authorSlug}
  data-search={searchText}
  data-sort-name={sortName}
  data-sort-category={sortCategory}
>
  <article class="card__body">
    <a class="card__link" href={href}>
      <img
        class="card__image"
        src={image}
        alt={alt}
        width="300"
        height="300"
        loading="lazy"
        decoding="async"
      />
      <h2 class="card__title">{entry.name}</h2>
    </a>
    <p class="card__publisher">
      <a href={pageUrl(publisherPath(locale, publisherSlug))}>{entry.publisher}</a>
    </p>
    {entry.author !== "Inconnu" && (
      <p class="card__author">
        <a href={pageUrl(authorPath(locale, slugifyAuthor(entry.author)))}>{entry.author}</a>
      </p>
    )}
    <ul class="badges" aria-label={t(locale, "cardFeatures", { name: entry.name })}>
      <li class="badge">{languageLabelFor(entry.language, locale)}</li>
      {group && <li class="badge">{groupLabel(group, locale)}</li>}
      <li
        class="badge"
        title={agesText ? t(locale, "cardAgesCovered", { ages: agesText }) : undefined}
      >
        {ageRange}
        {agesText && <span class="sr-only"> {t(locale, "cardAgesSr", { ages: agesText })}</span>}
      </li>
      <li class="badge badge--category">{categoryLabel(entry.category, locale)}</li>
    </ul>
    <FavoriteButton slug={entry.slug} locale={locale} size="sm" />
  </article>
</li>
