---
interface Props {
  slug: string;
  /** Taille du bouton (défaut: normal) */
  size?: "sm" | "normal";
  /** Variante visuelle */
  variant?: "icon" | "icon-text";
}
const { slug, size = "normal", variant = "icon" } = Astro.props;
---

<button
  type="button"
  class:list={["favorite-btn", `favorite-btn--${size}`, `favorite-btn--${variant}`]}
  data-favorite
  data-slug={slug}
  aria-pressed={false}
  aria-label="Ajouter aux favoris"
>
  <svg
    class="favorite-icon"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    aria-hidden="true"
    focusable="false"
    data-icon="outline"
  >
    <path
      d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    ></path>
  </svg>
  <svg
    class="favorite-icon"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    aria-hidden="true"
    focusable="false"
    data-icon="filled"
    style="display:none"
  >
    <path
      d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
      fill="currentColor"
      stroke="currentColor"
      stroke-width="2"
    ></path>
  </svg>
  {variant === "icon-text" && <span class="favorite-text">Favori</span>}
</button>

<style>
  .favorite-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
    transition:
      background 0.15s,
      border-color 0.15s,
      color 0.15s;
  }
  .favorite-btn:hover {
    border-color: var(--danger);
    color: var(--danger);
    background: var(--accent-soft);
  }
  .favorite-btn:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }
  .favorite-btn[aria-pressed="true"] {
    background: var(--danger);
    border-color: var(--danger);
    color: #fff;
  }
  .favorite-btn[aria-pressed="true"]:hover {
    background: #c0392b;
    border-color: #c0392b;
  }
  .favorite-btn--sm {
    padding: 0.25rem 0.4rem;
  }
  .favorite-btn--icon-text .favorite-text {
    font-size: 0.85rem;
    font-weight: 500;
  }
  .favorite-icon {
    flex: none;
  }
  .favorite-btn[aria-pressed="true"] [data-icon="outline"] {
    display: none;
  }
  .favorite-btn[aria-pressed="true"] [data-icon="filled"] {
    display: block;
  }
  .favorite-btn:not([aria-pressed="true"]) [data-icon="filled"] {
    display: none;
  }
</style>
