---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  categoryLabel,
  getCategories,
  getGroups,
  getLanguages,
  groupAgeRange,
  groupLabel,
  groupSlug,
  languageLabelFor,
} from "../../lib/catalog";
import { t, type Locale } from "../../lib/i18n";
import { alternates, searchPath } from "../../lib/routes";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const path = searchPath(locale);
const description = t(locale, "searchDescription");

/**
 * Tranches du catalogue : valeurs (`id`), segment d'URL (`slug`), anciens ids
 * (`aliases`) et libellés localisés. Rien n'est écrit en dur — ajouter une
 * tranche ou une langue ne demande aucune modification ici.
 */
const groups = getGroups().map((group) => ({
  id: group.id,
  slug: groupSlug(group, locale),
  aliases: group.aliases,
  label: groupLabel(group, locale),
  ageRange: groupAgeRange(group, locale),
}));
const categories = getCategories().map((category) => ({
  id: category.id,
  label: categoryLabel(category.id, locale),
}));
const languages = getLanguages().map((language) => ({
  id: language.code,
  label: languageLabelFor(language.code, locale),
}));
---

<BaseLayout
  title={t(locale, "searchTitle")}
  description={description}
  path={path}
  locale={locale}
  alternates={alternates(searchPath)}
>
  <section class="search-page" aria-labelledby="search-title">
    <header class="search-page__header">
      <h1 id="search-title">{t(locale, "searchHeading")}</h1>
      <p class="search-page__intro">
        {t(locale, "searchIntroBefore")} <kbd>{t(locale, "searchExample1")}</kbd>,{" "}
        <kbd>{t(locale, "searchExample2")}</kbd>, <kbd>{t(locale, "searchExample3")}</kbd>{" "}
        {t(locale, "searchIntroMiddle")} <strong id="search-stats-total">…</strong>{" "}
        {t(locale, "searchIntroAfter")}
      </p>
    </header>

    <form class="search-page__form" role="search" aria-label={t(locale, "searchFormLabel")}>
      <div class="search-page__input-wrapper">
        <label for="search-query" class="sr-only">
          {t(locale, "searchQueryLabel")}
        </label>
        <input
          id="search-query"
          type="search"
          name="q"
          placeholder={t(locale, "searchPlaceholder")}
          autocomplete="off"
          aria-describedby="search-hint"
          autofocus
        />
        <kbd class="search-page__shortcut" aria-hidden="true">
          {" "}
          /{" "}
        </kbd>
      </div>
      <p class="search-page__hint" id="search-hint">
        {t(locale, "searchHintBefore")} <kbd>/</kbd>
        {t(locale, "searchHintMiddle")} <kbd>{t(locale, "searchHintEscape")}</kbd>
        {t(locale, "searchHintAfter")}
      </p>
    </form>

    <div class="search-page__filters" role="group" aria-label={t(locale, "searchFilters")}>
      <label for="search-filter-language" class="sr-only">
        {t(locale, "catalogLanguage")}
      </label>
      <select id="search-filter-language" aria-label={t(locale, "searchFilterLanguage")}>
        <option value="">{t(locale, "catalogAllLanguages")}</option>
        {languages.map((language) => (
          <option value={language.id}>{language.label}</option>
        ))}
      </select>

      <label for="search-filter-category" class="sr-only">
        {t(locale, "catalogCategory")}
      </label>
      <select id="search-filter-category" aria-label={t(locale, "searchFilterCategory")}>
        <option value="">{t(locale, "catalogAllCategories")}</option>
      </select>

      <label for="search-filter-age" class="sr-only">
        {t(locale, "searchAge")}
      </label>
      <select id="search-filter-age" aria-label={t(locale, "searchFilterAge")}>
        <option value="">{t(locale, "searchAllAges")}</option>
        {groups.map((group) => (
          <option value={group.id}>
            {group.label} ({group.ageRange})
          </option>
        ))}
      </select>

      <button type="button" id="search-filter-reset" class="btn btn--ghost btn--sm" hidden>
        {t(locale, "catalogReset")}
      </button>
    </div>

    <div
      id="search-results"
      class="search-page__results"
      role="status"
      aria-live="polite"
      aria-busy="false"
    >
      <p class="search-page__empty" hidden>
        {t(locale, "searchEmpty")}
      </p>
      <p class="search-page__loading" hidden>
        {t(locale, "searchLoading")}
      </p>
    </div>

    <!--
      Modèle de résultat en `div hidden` plutôt qu'en `<template>` : le parseur
      HTML d'Astro duplique le lien `data-podcast-link` hors du `<template>` dans
      cette structure, ce qui laisse des `<a>` vides autour de la section.
    -->
    <div id="search-result-template" hidden>
      <article class="search-result">
        <header class="search-result__header">
          <h2 class="search-result__title"></h2>
          <div class="search-result__meta">
            <span class="search-result__podcast"></span>
            <span class="search-result__badges" aria-label={t(locale, "searchFeatures")}></span>
          </div>
        </header>
        <p class="search-result__description"></p>
        <footer class="search-result__footer">
          <time class="search-result__date" datetime=""></time>
          <span
            class="search-result__duration"
            aria-label={t(locale, "durationAria", { duration: "" })}
          ></span>
          <div class="search-result__actions">
            <button
              type="button"
              class="btn btn--primary btn--sm"
              data-play
              aria-label={t(locale, "searchListenAria")}
            >
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path d="M8 5.5v13l11-6.5z" fill="currentColor"></path>
              </svg>
              {t(locale, "episodeListen")}
            </button>
            <a class="btn btn--ghost btn--sm" href="" data-podcast-link>
              {t(locale, "searchViewPodcast")}
            </a>
          </div>
        </footer>
      </article>
    </div>
  </section>

  <style is:global>
    .search-page__header {
      margin-bottom: var(--space-6);
    }
    .search-page__intro {
      color: var(--color-text-muted);
      margin-top: var(--space-2);
    }
    .search-page__form {
      margin-bottom: var(--space-6);
    }
    .search-page__input-wrapper {
      position: relative;
      max-width: 640px;
    }
    .search-page__input-wrapper input {
      width: 100%;
      padding: var(--space-3) var(--space-4);
      padding-right: var(--space-12);
      font-size: var(--text-lg);
      border: 2px solid var(--color-border);
      border-radius: var(--radius);
      background: var(--color-surface);
      color: var(--color-text);
      transition:
        border-color var(--transition-fast),
        box-shadow var(--transition-fast);
    }
    .search-page__input-wrapper input:focus {
      outline: none;
      border-color: var(--color-primary);
      box-shadow: 0 0 0 3px var(--color-primary-focus);
    }
    .search-page__shortcut {
      position: absolute;
      right: var(--space-3);
      top: 50%;
      transform: translateY(-50%);
      font-size: var(--text-xs);
      color: var(--color-text-muted);
      background: var(--color-surface);
      padding: 0 var(--space-1);
      border-radius: var(--radius-sm);
    }
    .search-page__hint {
      margin-top: var(--space-2);
      font-size: var(--text-sm);
      color: var(--color-text-muted);
    }
    .search-page__filters {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      margin-bottom: var(--space-6);
      padding: var(--space-4);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
    }
    .search-page__filters select {
      padding: var(--space-2) var(--space-3);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      background: var(--color-background);
      color: var(--color-text);
      font-size: var(--text-sm);
      min-width: 160px;
    }
    .search-page__results {
      display: grid;
      gap: var(--space-4);
    }
    .search-page__empty,
    .search-page__loading {
      text-align: center;
      color: var(--color-text-muted);
      padding: var(--space-8);
      grid-column: 1 / -1;
    }
    .search-result {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      padding: var(--space-4);
      transition:
        border-color var(--transition-fast),
        box-shadow var(--transition-fast);
    }
    .search-result:hover {
      border-color: var(--color-primary);
      box-shadow: var(--shadow-md);
    }
    .search-result__header {
      margin-bottom: var(--space-2);
    }
    .search-result__title {
      font-size: var(--text-lg);
      font-weight: 600;
      margin: 0 0 var(--space-2);
      line-height: 1.3;
    }
    .search-result__title mark {
      background: var(--color-primary-light);
      color: var(--color-primary-dark);
      padding: 0 2px;
      border-radius: 2px;
    }
    .search-result__meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2);
      font-size: var(--text-sm);
    }
    .search-result__podcast {
      font-weight: 500;
      color: var(--color-text);
    }
    .search-result__badges {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-1);
    }
    .search-result__badges .badge {
      font-size: var(--text-xs);
    }
    .search-result__description {
      margin: 0 0 var(--space-3);
      color: var(--color-text-muted);
      font-size: var(--text-sm);
      line-height: 1.5;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .search-result__description mark {
      background: var(--color-primary-light);
      color: var(--color-primary-dark);
      padding: 0 2px;
      border-radius: 2px;
    }
    .search-result__footer {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3);
      padding-top: var(--space-3);
      border-top: 1px solid var(--color-border);
      font-size: var(--text-xs);
      color: var(--color-text-muted);
    }
    .search-result__date {
      white-space: nowrap;
    }
    .search-result__duration {
      font-variant-numeric: tabular-nums;
    }
    .search-result__actions {
      display: flex;
      gap: var(--space-2);
      margin-left: auto;
    }
    .btn--sm {
      padding: var(--space-1) var(--space-2);
      font-size: var(--text-xs);
    }
  </style>

  <!-- Tranches du catalogue (id, slug d'URL, anciens ids, libellés) : source unique côté client -->
  <script type="application/json" id="search-groups" set:html={JSON.stringify(groups)} />
  <script type="application/json" id="search-categories" set:html={JSON.stringify(categories)} />
  <script type="application/json" id="search-languages" set:html={JSON.stringify(languages)} />
  <!-- Script traité par Astro (TS compilé) — un `is:inline` laisserait tel quel le TypeScript, invalide en JS -->
  <script>
    import { isLocale, t } from "../../lib/i18n";
    import { pageUrl } from "../../lib/url";

    const rawLocale = document.documentElement.dataset.locale;
    const pageLocale = isLocale(rawLocale) ? rawLocale : "fr";

    // Configuration
    // `pageUrl` préfixe le `base` Astro : GitHub Pages publie sous `/nom-du-dépôt/`.
    const INDEX_URL = pageUrl("/search-index.json");
    const DEBOUNCE_MS = 80;
    const LOCALE_TAG = pageLocale === "fr" ? "fr-FR" : "en-GB";

    // État
    let searchIndex: SearchIndexEntry[] = [];
    let isIndexLoaded = false;

    // Éléments DOM
    const queryInput = document.getElementById("search-query") as HTMLInputElement;
    const resultsContainer = document.getElementById("search-results") as HTMLElement;
    const emptyMessage = resultsContainer.querySelector(".search-page__empty") as HTMLElement;
    const loadingMessage = resultsContainer.querySelector(".search-page__loading") as HTMLElement;
    const statsTotal = document.getElementById("search-stats-total") as HTMLElement;
    const languageFilter = document.getElementById("search-filter-language") as HTMLSelectElement;
    const categoryFilter = document.getElementById("search-filter-category") as HTMLSelectElement;
    const ageFilter = document.getElementById("search-filter-age") as HTMLSelectElement;
    const resetButton = document.getElementById("search-filter-reset") as HTMLButtonElement;
    const template = document.getElementById("search-result-template") as HTMLElement;
    /** Tranches du catalogue, injectées au build depuis `dist/index.json`. */
    const groupsData = JSON.parse(
      document.getElementById("search-groups")?.textContent ?? "[]",
    ) as SearchGroup[];
    const categoriesData = JSON.parse(
      document.getElementById("search-categories")?.textContent ?? "[]",
    ) as SearchLabel[];
    const languagesData = JSON.parse(
      document.getElementById("search-languages")?.textContent ?? "[]",
    ) as SearchLabel[];

    /** Une tranche par son id, son slug d'URL ou un ancien id (`?age=` partagé). */
    function findGroup(value: string): SearchGroup | undefined {
      if (!value) return undefined;
      return groupsData.find(
        (group) => group.id === value || group.slug === value || group.aliases.includes(value),
      );
    }

    function labelOf(list: SearchLabel[], id: string): string {
      return list.find((item) => item.id === id)?.label ?? id;
    }

    // Types
    interface SearchGroup {
      id: string;
      slug: string;
      aliases: string[];
      label: string;
      ageRange: string;
    }

    interface SearchLabel {
      id: string;
      label: string;
    }

    interface SearchIndexEntry {
      id: string;
      podcastSlug: string;
      podcastName: string;
      language: string;
      groupId: string;
      groupSlug?: string;
      category: string;
      title: string;
      description: string;
      pubDate: string;
      durationSec?: number;
      audioUrl?: string;
      episodeNumber?: number;
      seasonNumber?: number;
      imageUrl?: string;
    }

    interface SearchIndexFile {
      schemaVersion: number;
      catalogVersion: string;
      updatedAt: string;
      count: number;
      episodes: SearchIndexEntry[];
    }

    // Helpers
    function escapeHtml(text: string): string {
      const div = document.createElement("div");
      div.textContent = text;
      return div.innerHTML;
    }

    function highlight(text: string, query: string): string {
      if (!query.trim()) return escapeHtml(text);
      const escaped = escapeHtml(text);
      const terms = query
        .trim()
        .toLowerCase()
        .split(/\s+/)
        .filter((term) => term.length >= 2);
      let result = escaped;
      for (const term of terms) {
        const regex = new RegExp(`(${escapeRegExp(term)})`, "gi");
        result = result.replace(regex, "<mark>$1</mark>");
      }
      return result;
    }

    function escapeRegExp(string: string): string {
      return string.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    }

    function formatDate(value: string): string {
      if (!value) return "";
      try {
        return new Date(value).toLocaleDateString(LOCALE_TAG, {
          day: "numeric",
          month: "long",
          year: "numeric",
        });
      } catch {
        return value.slice(0, 10);
      }
    }

    function formatDuration(seconds?: number): string {
      if (!seconds || !Number.isFinite(seconds)) return "";
      const minutes = Math.floor(seconds / 60);
      const rest = seconds % 60;
      return `${minutes}:${String(rest).padStart(2, "0")}`;
    }

    function getAgeLabel(groupId: string): string {
      return findGroup(groupId)?.ageRange ?? groupId;
    }

    function getCategoryLabel(category: string): string {
      return labelOf(categoriesData, category);
    }

    function getLanguageLabel(language: string): string {
      return labelOf(languagesData, language);
    }

    // Chargement de l'index
    async function loadIndex(): Promise<void> {
      loadingMessage.hidden = false;
      resultsContainer.setAttribute("aria-busy", "true");
      try {
        const response = await fetch(INDEX_URL);
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const data = (await response.json()) as SearchIndexFile;
        searchIndex = data.episodes;
        isIndexLoaded = true;
        statsTotal.textContent = data.count.toLocaleString(LOCALE_TAG);
        buildCategoryFilter();
        console.log(t(pageLocale, "searchIndexLoaded", { count: data.count }));
      } catch (error) {
        console.error(t(pageLocale, "searchIndexError"), error);
        resultsContainer.innerHTML = `<p class="search-page__empty">${t(
          pageLocale,
          "searchError",
        )}</p>`;
      } finally {
        loadingMessage.hidden = true;
        resultsContainer.setAttribute("aria-busy", "false");
      }
    }

    function buildCategoryFilter(): void {
      const categories = new Set(searchIndex.map((entry) => entry.category));
      const currentValue = categoryFilter.value;
      categoryFilter.innerHTML = `<option value="">${t(pageLocale, "catalogAllCategories")}</option>`;
      for (const category of [...categories].sort()) {
        const option = document.createElement("option");
        option.value = category;
        option.textContent = getCategoryLabel(category);
        categoryFilter.appendChild(option);
      }
      categoryFilter.value = currentValue;
    }

    // Recherche
    let performSearch = () => {
      if (!isIndexLoaded) return;

      const query = queryInput.value.trim().toLowerCase();
      const language = languageFilter.value;
      const category = categoryFilter.value;
      const age = ageFilter.value;

      const hasFilters = query || language || category || age;
      resetButton.hidden = !hasFilters;

      let results = searchIndex;

      if (query) {
        const terms = query.split(/\s+/).filter((term) => term.length >= 2);
        results = results.filter((episode) => {
          const searchText =
            `${episode.title} ${episode.description} ${episode.podcastName}`.toLowerCase();
          return terms.every((term) => searchText.includes(term));
        });
      }

      if (language) results = results.filter((episode) => episode.language === language);
      if (category) results = results.filter((episode) => episode.category === category);
      if (age) results = results.filter((episode) => episode.groupId === age);

      renderResults(results, query);
    };

    function renderResults(results: SearchIndexEntry[], query: string): void {
      resultsContainer.innerHTML = "";
      emptyMessage.hidden = true;

      if (results.length === 0) {
        emptyMessage.hidden = false;
        return;
      }

      const fragment = document.createDocumentFragment();
      for (const episode of results) {
        const clone = template.firstElementChild?.cloneNode(true) as HTMLElement | null;
        if (!clone) continue;

        const titleElement = clone.querySelector(".search-result__title") as HTMLElement;
        titleElement.innerHTML = highlight(episode.title, query);

        const podcastElement = clone.querySelector(".search-result__podcast") as HTMLElement;
        podcastElement.textContent = episode.podcastName;

        const badgesElement = clone.querySelector(".search-result__badges") as HTMLElement;
        badgesElement.innerHTML = `
          <span class="badge">${getLanguageLabel(episode.language)}</span>
          <span class="badge">${getAgeLabel(episode.groupId)}</span>
          <span class="badge badge--category">${getCategoryLabel(episode.category)}</span>
        `;

        const descriptionElement = clone.querySelector(
          ".search-result__description",
        ) as HTMLElement;
        descriptionElement.innerHTML = highlight(episode.description, query);

        const dateElement = clone.querySelector(".search-result__date") as HTMLTimeElement;
        dateElement.textContent = formatDate(episode.pubDate);
        dateElement.dateTime = episode.pubDate;

        const durationElement = clone.querySelector(".search-result__duration") as HTMLElement;
        durationElement.textContent = formatDuration(episode.durationSec);
        if (episode.durationSec) {
          durationElement.setAttribute(
            "aria-label",
            t(pageLocale, "durationAria", { duration: formatDuration(episode.durationSec) }),
          );
        }

        const playButton = clone.querySelector("[data-play]") as HTMLButtonElement;
        playButton.dataset.audio = episode.audioUrl ?? "";
        playButton.dataset.title = episode.title;
        playButton.dataset.artist = episode.podcastName;
        playButton.dataset.album = episode.podcastName;
        playButton.dataset.episode = episode.id;

        const podcastLink = clone.querySelector("[data-podcast-link]") as HTMLAnchorElement;
        const segment = findGroup(episode.groupId)?.slug ?? episode.groupSlug ?? episode.groupId;
        podcastLink.href = pageUrl(`/${pageLocale}/${segment}/${episode.podcastSlug}/`);

        fragment.appendChild(clone);
      }
      resultsContainer.appendChild(fragment);
    }

    // Event listeners
    let debounceTimer: ReturnType<typeof setTimeout>;
    queryInput.addEventListener("input", () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(performSearch, DEBOUNCE_MS);
    });

    [languageFilter, categoryFilter, ageFilter].forEach((element) =>
      element.addEventListener("change", performSearch),
    );

    resetButton.addEventListener("click", () => {
      queryInput.value = "";
      languageFilter.value = "";
      categoryFilter.value = "";
      ageFilter.value = "";
      performSearch();
      queryInput.focus();
    });

    // Raccourcis clavier
    document.addEventListener("keydown", (event) => {
      if (event.key === "/" && !event.metaKey && !event.ctrlKey && !event.altKey) {
        const target = event.target as HTMLElement;
        if (
          !["INPUT", "TEXTAREA", "SELECT"].includes(target.tagName) &&
          !target.isContentEditable
        ) {
          event.preventDefault();
          queryInput.focus();
          queryInput.select();
        }
      }
      if (event.key === "Escape") {
        queryInput.value = "";
        queryInput.blur();
        performSearch();
      }
    });

    // Sync URL query param
    function syncUrl(): void {
      const params = new URLSearchParams(window.location.search);
      const query = queryInput.value.trim();
      if (query) params.set("q", query);
      else params.delete("q");
      if (languageFilter.value) params.set("lang", languageFilter.value);
      else params.delete("lang");
      if (categoryFilter.value) params.set("cat", categoryFilter.value);
      else params.delete("cat");
      if (ageFilter.value) params.set("age", ageFilter.value);
      else params.delete("age");
      const nextUrl = `${window.location.pathname}${
        params.toString() ? "?" + params.toString() : ""
      }`;
      history.replaceState(null, "", nextUrl);
    }

    // Restore from URL on load
    function restoreFromUrl(): void {
      const params = new URLSearchParams(window.location.search);
      if (params.get("q")) queryInput.value = params.get("q")!;
      if (params.get("lang")) languageFilter.value = params.get("lang")!;
      if (params.get("cat")) categoryFilter.value = params.get("cat")!;
      // `?age=` accepte un id, un slug ou un ancien id (lien partagé avant renommage)
      const age = params.get("age");
      if (age) ageFilter.value = findGroup(age)?.id ?? "";
    }

    // Debounced URL sync
    let urlSyncTimer: ReturnType<typeof setTimeout>;
    const originalPerformSearch = performSearch;
    performSearch = () => {
      originalPerformSearch();
      clearTimeout(urlSyncTimer);
      urlSyncTimer = setTimeout(syncUrl, 100);
    };

    // Initialisation
    restoreFromUrl();
    loadIndex();
  </script>
</BaseLayout>
