---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEntries, getPublishers } from "../../lib/catalog";
import { plural, t, type Locale } from "../../lib/i18n";
import { alternates, publisherPath, publishersPath } from "../../lib/routes";
import { pageUrl } from "../../lib/url";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const entries = getEntries();
const publishers = getPublishers(locale);
const podcastCount = plural(
  locale,
  entries.length,
  t(locale, "podcastSingular"),
  t(locale, "podcastPlural"),
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: t(locale, "publishersJsonLdName"),
  description: t(locale, "publishersJsonLdDescription"),
};

const title = `${t(locale, "publishersJsonLdName")} — ${t(locale, "siteName")}`;
const description = t(locale, "publishersDescription", {
  count: publishers.length,
  podcasts: podcastCount,
});
const path = publishersPath(locale);
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  jsonLd={jsonLd}
  locale={locale}
  alternates={alternates(publishersPath)}
>
  <section class="catalog" data-catalog aria-labelledby="titre-page">
    <header class="catalog__header">
      <h1 id="titre-page">{t(locale, "publishersHeading")}</h1>
      <p class="catalog__intro">{t(locale, "publishersIntro")}</p>
      <p class="catalog__count" role="status">
        {t(locale, "publishersCount", { count: publishers.length, podcasts: podcastCount })}
      </p>
    </header>

    <ul class="grid publishers-grid">
      {publishers.map((publisher) => (
        <li class="publisher-card">
          <a class="publisher-card__link" href={pageUrl(publisherPath(locale, publisher.slug))}>
            <span class="publisher-card__name">{publisher.name}</span>
            <span class="publisher-card__count">
              {plural(
                locale,
                publisher.count,
                t(locale, "podcastSingular"),
                t(locale, "podcastPlural"),
              )}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <style>
    .publishers-grid {
      grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    }
    .publisher-card {
      display: flex;
    }
    .publisher-card__link {
      display: block;
      width: 100%;
      padding: 1.25rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      text-decoration: none;
      color: inherit;
      transition:
        border-color 0.15s,
        box-shadow 0.15s;
    }
    .publisher-card__link:hover {
      border-color: var(--accent);
      box-shadow: var(--shadow);
    }
    .publisher-card__name {
      display: block;
      font-weight: 600;
      font-size: 1.05rem;
      margin-bottom: 0.35rem;
    }
    .publisher-card__count {
      display: block;
      font-size: 0.85rem;
      color: var(--accent);
      font-weight: 600;
    }
  </style>
</BaseLayout>
