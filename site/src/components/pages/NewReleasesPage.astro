---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEntries, getEpisodes } from "../../lib/catalog";
import { formatDate, isoDay } from "../../lib/format";
import { t, type Locale } from "../../lib/i18n";
import { alternates, entryPath, newReleasesPath } from "../../lib/routes";
import { itemListJsonLd } from "../../lib/seo";
import { pageUrl } from "../../lib/url";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const entries = getEntries();

// Récupérer tous les épisodes avec leur date de publication
const episodesWithMeta = entries.flatMap((entry) => {
  const episodes = getEpisodes(entry.slug);
  if (!episodes || episodes.episodes.length === 0) return [];
  return episodes.episodes.map((episode) => ({
    ...episode,
    podcast: entry,
    podcastUrl: entryPath(entry, locale),
  }));
});

// Trier par date de publication décroissante (plus récent en premier)
episodesWithMeta.sort((a, b) => {
  const da = a.pubDate ? new Date(a.pubDate).getTime() : 0;
  const db = b.pubDate ? new Date(b.pubDate).getTime() : 0;
  return db - da;
});

// Prendre les 50 plus récents
const recentEpisodes = episodesWithMeta.slice(0, 50);

const jsonLd = itemListJsonLd(
  t(locale, "newReleasesJsonLdName"),
  recentEpisodes.map((episode) => ({
    name: `${episode.podcast.name} — ${episode.title}`,
    path: episode.podcastUrl,
  })),
  Astro.site,
);

const title = `${t(locale, "newReleasesTitle")} — ${t(locale, "siteName")}`;
const description = t(locale, "newReleasesDescription", { count: recentEpisodes.length });
const path = newReleasesPath(locale);
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  jsonLd={jsonLd}
  locale={locale}
  alternates={alternates(newReleasesPath)}
>
  <section class="catalog" data-catalog aria-labelledby="titre-page">
    <header class="catalog__header">
      <h1 id="titre-page">{t(locale, "newReleasesHeading")}</h1>
      <p class="catalog__intro">{t(locale, "newReleasesIntro")}</p>
      <p class="catalog__count" role="status">
        {t(locale, "newReleasesCount", { count: recentEpisodes.length })}
      </p>
    </header>

    <ul class="grid episodes-grid">
      {recentEpisodes.map((episode) => {
        const date = formatDate(episode.pubDate, locale);
        const day = isoDay(episode.pubDate);
        const duration = episode.durationSec ? `${Math.floor(episode.durationSec / 60)} min` : "";
        return (
          <li class="episode-card">
            <article class="episode-card__body">
              <a class="episode-card__link" href={pageUrl(episode.podcastUrl)}>
                <img
                  class="episode-card__image"
                  src={episode.podcast.imageUrl || pageUrl("/placeholder.svg")}
                  alt={
                    episode.podcast.imageUrl
                      ? t(locale, "newReleasesCoverAlt", { name: episode.podcast.name })
                      : ""
                  }
                  width="300"
                  height="300"
                  loading="lazy"
                  decoding="async"
                />
                <h2 class="episode-card__title">{episode.title}</h2>
              </a>
              <p class="episode-card__podcast">
                <a href={pageUrl(episode.podcastUrl)}>{episode.podcast.name}</a>
              </p>
              <p class="episode-card__meta">
                {date && <time datetime={day ?? episode.pubDate}>{date}</time>}
                {duration && <span>{duration}</span>}
              </p>
              <p class="episode-card__actions">
                <a class="btn btn--ghost" href={pageUrl(episode.podcastUrl)}>
                  {t(locale, "newReleasesViewPodcast")}
                </a>
              </p>
            </article>
          </li>
        );
      })}
    </ul>

    {recentEpisodes.length === 0 && <p class="catalog__empty">{t(locale, "newReleasesEmpty")}</p>}
  </section>

  <style>
    .episodes-grid {
      grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    }
    .episode-card {
      display: flex;
    }
    .episode-card__body {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      width: 100%;
      padding: 0.85rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }
    .episode-card__link {
      display: block;
      color: inherit;
      text-decoration: none;
    }
    .episode-card__link:hover .episode-card__title {
      color: var(--accent);
    }
    .episode-card__image {
      display: block;
      width: 100%;
      aspect-ratio: 1;
      object-fit: cover;
      border-radius: var(--radius-sm);
      background: var(--surface-2);
      margin-bottom: 0.6rem;
    }
    .episode-card__title {
      font-size: 1rem;
      margin: 0;
      line-height: 1.3;
    }
    .episode-card__podcast {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin: 0;
    }
    .episode-card__podcast a {
      color: inherit;
      text-decoration: none;
    }
    .episode-card__podcast a:hover {
      color: var(--accent);
    }
    .episode-card__meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      font-size: 0.8rem;
      color: var(--text-muted);
      margin: 0;
    }
    .episode-card__actions {
      margin-top: 0.25rem;
    }
  </style>
</BaseLayout>
