---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CatalogBrowser from "../CatalogBrowser.astro";
import {
  authorOptions,
  categoryOptions,
  getEntries,
  getGroups,
  getManifest,
  groupAgeRange,
  groupLabel,
  groupOptions,
  languageOptions,
} from "../../lib/catalog";
import { t, type Locale } from "../../lib/i18n";
import { alternates, entryPath, groupPath, homePath } from "../../lib/routes";
import { itemListJsonLd } from "../../lib/seo";
import { pageUrl } from "../../lib/url";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const entries = getEntries();
const manifest = getManifest();
const groups = getGroups();

const groupNav = groups
  .map((group) => ({
    href: pageUrl(groupPath(locale, group)),
    label: `${groupLabel(group, locale)} · ${groupAgeRange(group, locale)}`,
    count: entries.filter((entry) => entry.groupId === group.id).length,
    active: false,
  }))
  .filter((item) => item.count > 0);

const jsonLd = itemListJsonLd(
  t(locale, "homeTitle"),
  entries.map((entry) => ({
    name: entry.name,
    path: entryPath(entry, locale),
  })),
  Astro.site,
);

const title = t(locale, "homeTitle");
const description = t(locale, "homeDescription", { count: manifest.counts.total });
const path = homePath(locale);
---

<script is:inline>
  function goRandomPodcast() {
    const button = document.querySelector("[data-entries]");
    const entries = JSON.parse(button?.dataset.entries ?? "[]");
    if (entries.length === 0) return;
    const random = entries[Math.floor(Math.random() * entries.length)];
    window.location.href = random.path;
  }
</script>

<BaseLayout
  title={title}
  description={description}
  path={path}
  jsonLd={jsonLd}
  locale={locale}
  alternates={alternates(homePath)}
>
  <section class="hero" aria-labelledby="titre-accueil">
    <header class="hero__header">
      <h1 id="titre-accueil">{title}</h1>
      <p class="hero__intro">{t(locale, "homeIntro")}</p>
      <div class="hero__actions">
        <button
          type="button"
          class="btn btn--primary"
          onclick="goRandomPodcast()"
          aria-label={t(locale, "randomPodcastAria")}
          data-entries={JSON.stringify(
            entries.map((entry) => ({
              slug: entry.slug,
              path: pageUrl(entryPath(entry, locale)),
            })),
          )}
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path
              d="M12 2a10 10 0 0 1 7.38 16.75A1.5 1.5 0 0 0 21 18.5V16a1 1 0 0 0-1-1h-3a1 1 0 0 1-.88-1.5A8 8 0 0 0 12 2z"
              fill="currentColor"
            ></path>
            <path
              d="M12 22a10 10 0 0 1-7.38-16.75A1.5 1.5 0 0 0 3 5.5V8a1 1 0 0 0 1 1h3a1 1 0 0 1 .88 1.5A8 8 0 0 1 12 22z"
              fill="currentColor"
            ></path>
          </svg>
          {t(locale, "randomPodcast")}
        </button>
      </div>
    </header>
  </section>
  <CatalogBrowser
    title={title}
    entries={entries}
    locale={locale}
    languages={languageOptions(entries, locale)}
    groups={groupOptions(entries, locale)}
    categories={categoryOptions(entries, locale)}
    authors={authorOptions(entries, locale)}
    nav={{ label: t(locale, "groupAllGroups"), items: groupNav }}
  />
</BaseLayout>
