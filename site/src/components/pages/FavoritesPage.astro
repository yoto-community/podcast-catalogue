---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { categoryLabel, entryAgeRange, getEntries, languageLabelFor } from "../../lib/catalog";
import { plural, t, type Locale } from "../../lib/i18n";
import { alternates, entryPath, favoritesPath, homePath } from "../../lib/routes";
import { pageUrl } from "../../lib/url";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const entries = getEntries();
const path = favoritesPath(locale);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: t(locale, "favoritesJsonLdName"),
  description: t(locale, "favoritesJsonLdDescription"),
};

const title = t(locale, "favoritesTitle");
const description = t(locale, "favoritesDescription");
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  jsonLd={jsonLd}
  locale={locale}
  alternates={alternates(favoritesPath)}
>
  <section class="catalog" data-catalog aria-labelledby="titre-page">
    <header class="catalog__header">
      <h1 id="titre-page">{t(locale, "favoritesHeading")}</h1>
      <p class="catalog__intro">{t(locale, "favoritesIntro")}</p>
      <p class="catalog__count" role="status" data-fav-count>
        {plural(locale, 0, t(locale, "podcastSingular"), t(locale, "podcastPlural"))}
      </p>
    </header>

    <div class="favorites-empty" hidden>
      <p class="empty-title">{t(locale, "favoritesEmptyTitle")}</p>
      <p class="empty-text">
        {t(locale, "favoritesEmptyBefore")}{" "}
        <a href={pageUrl(homePath(locale))}>{t(locale, "favoritesEmptyCatalogue")}</a>{" "}
        <svg class="inline-heart" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path
            d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          ></path>
        </svg>{" "}
        {t(locale, "favoritesEmptyAfter")}
      </p>
    </div>

    <ul class="grid" data-fav-list>
      {entries.map((entry) => (
        <li
          class="card"
          data-entry
          data-language={entry.language}
          data-group={entry.groupId}
          data-category={entry.category}
          data-fav-slug={entry.slug}
          hidden
        >
          <article class="card__body">
            <a class="card__link" href={pageUrl(entryPath(entry, locale))}>
              <img
                class="card__image"
                src={entry.imageUrl || pageUrl("/placeholder.svg")}
                alt={entry.imageUrl ? t(locale, "coverAlt", { name: entry.name }) : ""}
                width="300"
                height="300"
                loading="lazy"
                decoding="async"
              />
              <h2 class="card__title">{entry.name}</h2>
            </a>
            <p class="card__publisher">{entry.publisher}</p>
            <ul class="badges" aria-label={t(locale, "cardFeatures", { name: entry.name })}>
              <li class="badge">{languageLabelFor(entry.language, locale)}</li>
              <li class="badge">{entryAgeRange(entry, locale)}</li>
              <li class="badge badge--category">{categoryLabel(entry.category, locale)}</li>
            </ul>
          </article>
        </li>
      ))}
    </ul>
  </section>

  <script>
    import { getFavorites, onFavoritesChange } from "../../scripts/favorites.ts";
    import { isLocale, plural, t } from "../../lib/i18n";

    const rawLocale = document.documentElement.dataset.locale;
    const pageLocale = isLocale(rawLocale) ? rawLocale : "fr";

    function render(favs: string[]): void {
      // Les références sont relues à chaque rendu : après une navigation interne,
      // <main> contient un DOM neuf (micro-routeur, voir site.ts).
      const list = document.querySelector<HTMLElement>("[data-fav-list]");
      const countEl = document.querySelector<HTMLElement>("[data-fav-count]");
      const emptyEl = document.querySelector<HTMLElement>(".favorites-empty");
      const items = list ? Array.from(list.querySelectorAll<HTMLElement>("[data-fav-slug]")) : [];

      let visible = 0;
      items.forEach((item) => {
        const slug = item.dataset.favSlug;
        const isFav = !!slug && favs.includes(slug);
        item.hidden = !isFav;
        if (isFav) visible++;
      });
      if (countEl) {
        countEl.textContent = plural(
          pageLocale,
          visible,
          t(pageLocale, "podcastSingular"),
          t(pageLocale, "podcastPlural"),
        );
      }
      if (emptyEl) emptyEl.hidden = visible > 0;
    }

    // Initial
    render(getFavorites());

    // Écoute changements (favoris cochés ailleurs, multi-onglets)
    onFavoritesChange(render);

    // Navigation interne : le micro-routeur a remplacé <main>
    document.addEventListener("yoto:page-ready", () => render(getFavorites()));
  </script>
  <style>
    .inline-heart {
      display: inline-block;
      vertical-align: middle;
      margin-left: 0.2rem;
      color: var(--danger);
    }
    .favorites-empty {
      text-align: center;
      padding: 3rem 1rem;
      color: var(--text-muted);
      border: 1px dashed var(--border);
      border-radius: var(--radius);
      background: var(--surface);
    }
    .empty-title {
      font-size: 1.2rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
      color: var(--text);
    }
    .empty-text {
      max-width: 30rem;
      margin: 0 auto;
    }
    .empty-text a {
      color: var(--accent);
      font-weight: 500;
    }
  </style>
</BaseLayout>
