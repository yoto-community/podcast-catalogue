---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEntries, getTags, tagDescription, tagLabel } from "../../lib/catalog";
import { plural, t, type Locale } from "../../lib/i18n";
import { alternates, themesPath, themePath } from "../../lib/routes";
import { pageUrl } from "../../lib/url";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const entries = getEntries();
const tags = getTags();

const tagStats = tags
  .map((tag) => ({
    ...tag,
    label: tagLabel(tag.id, locale),
    description: tagDescription(tag.id, locale),
    count: entries.filter((entry) => entry.tags?.includes(tag.id)).length,
  }))
  .filter((tag) => tag.count > 0);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: t(locale, "themesJsonLdName"),
  description: t(locale, "themesJsonLdDescription"),
};

const title = `${t(locale, "themesTitle")} — ${t(locale, "siteName")}`;
const description = t(locale, "themesDescription", { count: tagStats.length });
const path = themesPath(locale);
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  jsonLd={jsonLd}
  locale={locale}
  alternates={alternates(themesPath)}
>
  <section class="catalog" data-catalog aria-labelledby="titre-page">
    <header class="catalog__header">
      <h1 id="titre-page">{t(locale, "themesHeading")}</h1>
      <p class="catalog__intro">{t(locale, "themesIntro")}</p>
      <p class="catalog__count" role="status">
        {t(locale, "themesCount", { count: tagStats.length })}
      </p>
    </header>

    <ul class="grid themes-grid">
      {tagStats.map((tag) => (
        <li class="theme-card">
          <a class="theme-card__link" href={pageUrl(themePath(locale, tag.id))}>
            <span class="theme-card__label">{tag.label}</span>
            <span class="theme-card__count">
              {plural(locale, tag.count, t(locale, "podcastSingular"), t(locale, "podcastPlural"))}
            </span>
            {tag.description && <span class="theme-card__desc">{tag.description}</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <style>
    .themes-grid {
      grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    }
    .theme-card {
      display: flex;
    }
    .theme-card__link {
      display: block;
      width: 100%;
      padding: 1.25rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      text-decoration: none;
      color: inherit;
      transition:
        border-color 0.15s,
        box-shadow 0.15s;
    }
    .theme-card__link:hover {
      border-color: var(--accent);
      box-shadow: var(--shadow);
    }
    .theme-card__label {
      display: block;
      font-weight: 600;
      font-size: 1.05rem;
      margin-bottom: 0.35rem;
    }
    .theme-card__count {
      display: block;
      font-size: 0.85rem;
      color: var(--accent);
      font-weight: 600;
    }
    .theme-card__desc {
      display: block;
      margin-top: 0.4rem;
      font-size: 0.85rem;
      color: var(--text-muted);
    }
  </style>
</BaseLayout>
