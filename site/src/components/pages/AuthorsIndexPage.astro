---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAuthors, getEntries } from "../../lib/catalog";
import { plural, t, type Locale } from "../../lib/i18n";
import { alternates, authorPath, authorsPath } from "../../lib/routes";
import { pageUrl } from "../../lib/url";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const entries = getEntries();
const authors = getAuthors(locale);
const podcastCount = plural(
  locale,
  entries.length,
  t(locale, "podcastSingular"),
  t(locale, "podcastPlural"),
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: t(locale, "authorsJsonLdName"),
  description: t(locale, "authorsJsonLdDescription"),
};

const title = `${t(locale, "authorsJsonLdName")} — ${t(locale, "siteName")}`;
const description = t(locale, "authorsDescription", {
  count: authors.length,
  podcasts: podcastCount,
});
const path = authorsPath(locale);
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  jsonLd={jsonLd}
  locale={locale}
  alternates={alternates(authorsPath)}
>
  <section class="catalog" data-catalog aria-labelledby="titre-page">
    <header class="catalog__header">
      <h1 id="titre-page">{t(locale, "authorsHeading")}</h1>
      <p class="catalog__intro">{t(locale, "authorsIntro")}</p>
      <p class="catalog__count" role="status">
        {t(locale, "authorsCount", { count: authors.length, podcasts: podcastCount })}
      </p>
    </header>

    <ul class="grid authors-grid">
      {authors.map((author) => (
        <li class="author-card">
          <a class="author-card__link" href={pageUrl(authorPath(locale, author.slug))}>
            <span class="author-card__name">{author.name}</span>
            <span class="author-card__count">
              {plural(
                locale,
                author.count,
                t(locale, "podcastSingular"),
                t(locale, "podcastPlural"),
              )}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <style>
    .authors-grid {
      grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    }
    .author-card {
      display: flex;
    }
    .author-card__link {
      display: block;
      width: 100%;
      padding: 1.25rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      text-decoration: none;
      color: inherit;
      transition:
        border-color 0.15s,
        box-shadow 0.15s;
    }
    .author-card__link:hover {
      border-color: var(--accent);
      box-shadow: var(--shadow);
    }
    .author-card__name {
      display: block;
      font-weight: 600;
      font-size: 1.05rem;
      margin-bottom: 0.35rem;
    }
    .author-card__count {
      display: block;
      font-size: 0.85rem;
      color: var(--accent);
      font-weight: 600;
    }
  </style>
</BaseLayout>
