---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CatalogBrowser from "../CatalogBrowser.astro";
import {
  authorOptions,
  categoryOptions,
  entriesOfPublisher,
  getPublishers,
  groupOptions,
  languageOptions,
} from "../../lib/catalog";
import { t, type Locale } from "../../lib/i18n";
import { alternates, authorPath, entryPath, publisherPath, publishersPath } from "../../lib/routes";
import { itemListJsonLd } from "../../lib/seo";
import { pageUrl } from "../../lib/url";

interface Props {
  locale: Locale;
  publisher: { name: string; slug: string; count: number };
}

const { locale, publisher } = Astro.props;
const entries = entriesOfPublisher(publisher.slug);
const path = publisherPath(locale, publisher.slug);

const jsonLd = itemListJsonLd(
  t(locale, "publisherJsonLdName", { name: publisher.name }),
  entries.map((entry) => ({
    name: entry.name,
    path: entryPath(entry, locale),
  })),
  Astro.site,
);

const title = `${publisher.name} — ${t(locale, "siteName")}`;
const description = t(locale, "publisherDescription", {
  count: entries.length,
  name: publisher.name,
});

// Auteurs liés à cet éditeur
const authors = authorOptions(entries, locale);
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  jsonLd={jsonLd}
  locale={locale}
  alternates={alternates((code) => publisherPath(code, publisher.slug))}
>
  <nav class="breadcrumb" aria-label={t(locale, "breadcrumb")}>
    <ol>
      <li>
        <a href={pageUrl(`/${locale}/`)}>{t(locale, "navCatalogue")}</a>
      </li>
      <li>
        <a href={pageUrl(publishersPath(locale))}>{t(locale, "navPublishers")}</a>
      </li>
      <li>
        <span aria-current="page">{publisher.name}</span>
      </li>
    </ol>
  </nav>

  {authors.length > 0 && (
    <section class="publisher-authors" aria-labelledby="authors-heading">
      <h2 id="authors-heading">{t(locale, "publisherAuthorsHeading")}</h2>
      <ul class="publisher-authors__list">
        {authors.map((author) => (
          <li class="publisher-authors__item">
            <a href={pageUrl(authorPath(locale, author.value))}>
              <span class="publisher-authors__name">{author.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <CatalogBrowser
    title={publisher.name}
    intro={t(locale, "publisherIntro", { count: entries.length, name: publisher.name })}
    entries={entries}
    locale={locale}
    languages={languageOptions(entries, locale)}
    groups={groupOptions(entries, locale)}
    categories={categoryOptions(entries, locale)}
    authors={authors}
    preset={{}}
    showAuthorFilter={true}
    nav={{
      label: t(locale, "publishersAll"),
      items: [
        {
          href: pageUrl(publishersPath(locale)),
          label: t(locale, "publishersAll"),
          count: getPublishers().length,
          active: false,
        },
      ],
    }}
  />
</BaseLayout>

<style>
  .publisher-authors {
    margin: var(--space-6) 0;
    padding: var(--space-4);
    background: var(--surface);
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .publisher-authors h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .publisher-authors__list {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .publisher-authors__item {
    flex: 0 0 auto;
  }
  .publisher-authors__item a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) 0;
    color: var(--text);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 500;
    transition: color 0.15s;
  }
  .publisher-authors__item a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
