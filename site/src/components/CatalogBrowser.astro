---
import PodcastCard from "./PodcastCard.astro";
import { plural, t, type Locale } from "../lib/i18n";
import { sortByName, ageOptions } from "../lib/catalog";
import type { DistEntry, FilterOption, NavItem } from "../lib/types";

interface Props {
  title: string;
  intro?: string;
  entries: DistEntry[];
  languages: FilterOption[];
  /** Tranches présentes — pilote l'affichage du filtre « âge » (masqué si preset). */
  groups: FilterOption[];
  categories: FilterOption[];
  authors: FilterOption[];
  locale: Locale;
  /** Filtres déjà imposés par la page (masqués dans l'interface). */
  preset?: { language?: string; group?: string };
  /** Afficher le filtre auteur en permanence (hors section pliable). */
  showAuthorFilter?: boolean;
  nav?: { label: string; items: NavItem[] };
}

const {
  title,
  intro,
  entries,
  languages,
  groups,
  categories,
  authors,
  locale,
  preset,
  showAuthorFilter,
  nav,
} = Astro.props;
const sorted = sortByName(entries, locale);
const showLanguages = !preset?.language && languages.length > 1;
const ages = ageOptions(entries, locale);
const showAges = !preset?.group && groups.length > 1 && ages.length > 1;
const showCategories = categories.length > 1;
const showAuthors = authors.length > 1;
const podcastCount = (count: number) =>
  plural(locale, count, t(locale, "podcastSingular"), t(locale, "podcastPlural"));
---

<section class="catalog" data-catalog aria-labelledby="titre-page">
  <header class="catalog__header">
    <h1 id="titre-page">{title}</h1>
    {intro && <p class="catalog__intro">{intro}</p>}
    <p class="catalog__count" data-count role="status" aria-live="polite" aria-atomic="true">
      {podcastCount(entries.length)}
    </p>
  </header>

  {nav && nav.items.length > 1 && (
    <nav class="catalog__nav" aria-label={nav.label}>
      <ul>
        {nav.items.map((item) => (
          <li>
            <a href={item.href} aria-current={item.active ? "page" : undefined}>
              <span>{item.label}</span>
              <span class="catalog__nav-count">{item.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  <form class="filters" role="search" data-search-form aria-controls="catalog-list">
    <!-- Mobile filter toggle button -->
    <button
      class="filters__toggle"
      type="button"
      data-filters-toggle
      aria-expanded="false"
      aria-controls="filters-content"
      hidden
    >
      <span class="filters__toggle-label">
        <svg
          class="filters__toggle-icon"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M7 10l5 5 5-5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
        {t(locale, "catalogFilters")}
        <span class="filters__toggle-count" data-toggle-count>
          {podcastCount(entries.length)}
        </span>
      </span>
    </button>

    <div class="filters__content" id="filters-content" hidden>
      <div class="filters__row">
        <div class="field field--search">
          <label for="recherche">{t(locale, "catalogSearchLabel")}</label>
          <div class="field__control">
            <input
              id="recherche"
              type="search"
              name="q"
              data-search
              placeholder={t(locale, "catalogSearchPlaceholder")}
              autocomplete="search"
              aria-describedby="recherche-aide"
            />
            <kbd class="field__shortcut" aria-hidden="true">
              {" "}
              /{" "}
            </kbd>
          </div>
          <p class="field__help" id="recherche-aide">
            {t(locale, "catalogSearchHelpBefore")} <kbd>/</kbd>
            {t(locale, "catalogSearchHelpAfter")}
          </p>
        </div>

        {showAuthorFilter && showAuthors && (
          <div class="field field--author-visible">
            <label for="filtre-auteur-visible">{t(locale, "catalogAuthor")}</label>
            <select id="filtre-auteur-visible" data-filter="author">
              <option value="">{t(locale, "catalogAllAuthors")}</option>
              {authors.map((option) => (
                <option value={option.value}>
                  {option.label} ({option.count})
                </option>
              ))}
            </select>
          </div>
        )}

        {showLanguages && (
          <div class="field">
            <label for="filtre-langue">{t(locale, "catalogLanguage")}</label>
            <select id="filtre-langue" data-filter="language">
              <option value="">{t(locale, "catalogAllLanguages")}</option>
              {languages.map((option) => (
                <option value={option.value}>
                  {option.label} ({option.count})
                </option>
              ))}
            </select>
          </div>
        )}

        {showAges && (
          <fieldset class="field field--ages">
            <legend>{t(locale, "catalogAge")}</legend>
            <div class="ages">
              {ages.map((option) => (
                <label class="age-chip">
                  <input
                    class="age-chip__input"
                    type="checkbox"
                    name="ages"
                    value={option.age}
                    data-age={option.age}
                    aria-label={t(locale, "catalogAgeAria", {
                      longLabel: option.longLabel,
                      count: podcastCount(option.count),
                    })}
                    aria-describedby="filtre-age-aide"
                  />
                  <span class="age-chip__face">
                    <span class="age-chip__label">{option.shortLabel}</span>
                    <span class="age-chip__count" aria-hidden="true">
                      {option.count.toString().trim()}
                    </span>
                  </span>
                </label>
              ))}
            </div>
            <p class="field__help" id="filtre-age-aide">
              {t(locale, "catalogAgeHelp")}
            </p>
          </fieldset>
        )}

        {showCategories && (
          <div class="field">
            <label for="filtre-categorie">{t(locale, "catalogCategory")}</label>
            <select id="filtre-categorie" data-filter="category">
              <option value="">{t(locale, "catalogAllCategories")}</option>
              {categories.map((option) => (
                <option value={option.value}>
                  {option.label} ({option.count})
                </option>
              ))}
            </select>
          </div>
        )}

        {!showAuthorFilter && showAuthors && (
          <div class="field">
            <label for="filtre-auteur">{t(locale, "catalogAuthor")}</label>
            <select id="filtre-auteur" data-filter="author">
              <option value="">{t(locale, "catalogAllAuthors")}</option>
              {authors.map((option) => (
                <option value={option.value}>
                  {option.label} ({option.count})
                </option>
              ))}
            </select>
          </div>
        )}
      </div>

      <div class="filters__row filters__row--footer">
        <div class="field field--sort">
          <span class="field__label" id="tri-label">
            {t(locale, "catalogSort")}
          </span>
          <div class="sort" role="group" aria-labelledby="tri-label">
            <button type="button" class="sort__button" data-sort="name" aria-pressed="true">
              {t(locale, "catalogSortName")}
            </button>
            <button type="button" class="sort__button" data-sort="category" aria-pressed="false">
              {t(locale, "catalogSortCategory")}
            </button>
          </div>
        </div>
        <button type="button" class="filters__reset" data-reset>
          {t(locale, "catalogReset")}
        </button>
      </div>
    </div>
  </form>

  <!-- Active filter chips (populated by JS) -->
  <div
    class="active-filters"
    id="active-filters"
    aria-live="polite"
    aria-atomic="true"
    hidden
  ></div>

  <p class="catalog__empty" data-empty hidden>
    {t(locale, "catalogEmpty")}
  </p>

  <ul class="grid" id="catalog-list" data-list>
    {sorted.map((entry) => (
      <PodcastCard entry={entry} locale={locale} />
    ))}
  </ul>
</section>

<script is:inline>
  // Minimal inline script to show mobile filter toggle when needed
  // Full filter logic is in site.ts (hydrated after navigation)
  document.addEventListener("DOMContentLoaded", () => {
    const toggle = document.querySelector("[data-filters-toggle]");
    const content = document.getElementById("filters-content");
    if (toggle && content) {
      // Show toggle on mobile (CSS handles visibility)
      toggle.hidden = false;
    }
  });
</script>
