---
import { externalUrl } from "../lib/catalog";
import { plural, t, type Locale } from "../lib/i18n";
import { formatDate, formatDuration, isoDay, truncate } from "../lib/format";
import type { DistEntry, DistEpisode, DistEpisodesFile } from "../lib/types";

interface Props {
  entry: DistEntry;
  episodes: DistEpisodesFile | null;
  locale: Locale;
}

const { entry, episodes, locale } = Astro.props;
const external = externalUrl(entry);

function isPlayable(episode: DistEpisode): boolean {
  if (episode.insecure) return false;
  if (!episode.audioUrl) return false;
  return /^https:\/\//i.test(episode.audioUrl);
}

const list = episodes?.episodes ?? [];
const fetchedAt = episodes?.fetchedAt;
const fetchedLabel = formatDate(fetchedAt, locale);
const fetchedDay = isoDay(fetchedAt);
const episodeCount = (count: number) =>
  plural(locale, count, t(locale, "episodeSingular"), t(locale, "episodePlural"));
---

{list.length > 0 ? (
  <div class="episodes">
    <p class="episodes__freshness">
      {fetchedLabel && (
        <>
          {t(locale, "episodesUpdated")}{" "}
          <time datetime={fetchedDay ?? fetchedAt}>{fetchedLabel}</time>
          {" · "}
        </>
      )}
      {episodeCount(list.length)}{" "}
      {t(locale, "episodesIndexedSuffix", { total: episodes?.count ?? list.length })}
    </p>

    <ol class="episodes__list">
      {list.map((episode) => {
        const playable = isPlayable(episode);
        const date = formatDate(episode.pubDate, locale);
        const day = isoDay(episode.pubDate);
        const duration = formatDuration(episode.durationSec, locale);
        const description = truncate(episode.description, 300);

        return (
          <li class="episode">
            <div class="episode__body">
              <h3 class="episode__title">{episode.title}</h3>
              <p class="episode__meta">
                {date && <time datetime={day ?? episode.pubDate}>{date}</time>}
                {duration && <span>{duration}</span>}
                {episode.episodeNumber !== undefined && (
                  <span>{t(locale, "episodeNumber", { number: episode.episodeNumber })}</span>
                )}
              </p>
              {description && <p class="episode__description">{description}</p>}
              {!playable && <p class="episode__notice">{t(locale, "episodeUnavailable")}</p>}
            </div>

            <div class="episode__actions">
              {playable ? (
                <button
                  type="button"
                  class="btn btn--primary"
                  data-play
                  data-episode={episode.id}
                  data-audio={episode.audioUrl}
                  data-title={episode.title}
                  data-artist={entry.publisher}
                  data-album={entry.name}
                  data-external={external}
                  data-image={entry.imageUrl}
                  aria-label={t(locale, "episodeListenAria", { title: episode.title })}
                  aria-pressed="false"
                >
                  <svg
                    viewBox="0 0 24 24"
                    width="16"
                    height="16"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M8 5.5v13l11-6.5z" fill="currentColor" />
                  </svg>
                  {t(locale, "episodeListen")}
                  <span class="sr-only"> {t(locale, "episodeListenSr")}</span>
                </button>
              ) : (
                <a
                  class="btn btn--primary"
                  href={external}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {t(locale, "episodesListenExternal")}
                  <span class="sr-only"> {t(locale, "newTab")}</span>
                </a>
              )}

              {playable && (
                <a
                  class="btn btn--ghost"
                  href={episode.audioUrl}
                  download
                  aria-label={t(locale, "episodeDownloadAria", { title: episode.title })}
                >
                  {t(locale, "episodeDownload")}
                </a>
              )}
            </div>
          </li>
        );
      })}
    </ol>
  </div>
) : (
  <div class="state" data-episodes-empty>
    <p class="state__title">{t(locale, "episodesEmptyTitle")}</p>
    <p class="state__text">{t(locale, "episodesEmptyText")}</p>
    <p class="state__actions">
      <a class="btn btn--primary" href={external} target="_blank" rel="noopener noreferrer">
        {t(locale, "episodesListenExternal")}
        <span class="sr-only"> {t(locale, "newTab")}</span>
      </a>
      <a class="btn btn--ghost" href={entry.rssUrl} target="_blank" rel="noopener noreferrer">
        {t(locale, "episodesViewRss")}
        <span class="sr-only"> {t(locale, "newTab")}</span>
      </a>
    </p>
  </div>
)}
